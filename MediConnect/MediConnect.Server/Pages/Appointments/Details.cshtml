@page "{id:int}"
@model MediConnect.Server.Pages.Appointments.DetailsModel
@{
    ViewData["Title"] = "Chi tiết lịch hẹn";
}

@if (Model.Appointment == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> Không tìm thấy lịch hẹn.
    </div>
}
else
{
    var appt = Model.Appointment;

    <h2 class="page-header"><i class="bi bi-calendar-check"></i> Chi tiết lịch hẹn #@appt.AppointmentId</h2>

    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th style="width:200px;">Bác sĩ:</th>
                            <td>@appt.Doctor.FullName</td>
                        </tr>
                        <tr>
                            <th>Bệnh nhân:</th>
                            <td>@appt.Patient.FullName</td>
                        </tr>
                        <tr>
                            <th>Chuyên khoa:</th>
                            <td>@(appt.Specialty?.SpecialtyName ?? "—")</td>
                        </tr>
                        <tr>
                            <th>Ngày hẹn:</th>
                            <td>@appt.AppointmentDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Giờ:</th>
                            <td>@appt.StartTime.ToString("HH:mm") - @appt.EndTime.ToString("HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Trạng thái:</th>
                            <td>
                                <span class="badge @Model.GetBadgeClass(appt.Status) fs-6">@appt.Status</span>
                            </td>
                        </tr>
                        <tr>
                            <th>Lý do khám:</th>
                            <td>@(appt.Reason ?? "—")</td>
                        </tr>
                        <tr>
                            <th>Ghi chú:</th>
                            <td>@(appt.Notes ?? "—")</td>
                        </tr>
                        <tr>
                            <th>Ngày tạo:</th>
                            <td>@appt.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="d-grid gap-2">
                <a asp-page="/Appointments/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
                @if (appt.Status == "PENDING" || appt.Status == "CONFIRMED")
                {
                    <a asp-page="/Appointments/Cancel" asp-route-id="@appt.AppointmentId"
                       class="btn btn-outline-danger">
                        <i class="bi bi-x-circle"></i> Hủy lịch hẹn
                    </a>
                }
            </div>
        </div>
    </div>
}
