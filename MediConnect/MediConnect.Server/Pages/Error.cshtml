@page
@model MediConnect.Server.Pages.ErrorModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="text-center py-5">
    <h1 class="display-4 text-danger"><i class="bi bi-exclamation-triangle"></i> Đã xảy ra lỗi</h1>
    <p class="lead text-muted">Xin lỗi, đã có sự cố xảy ra khi xử lý yêu cầu của bạn.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary mt-3">
        <i class="bi bi-house"></i> Quay về trang chủ
    </a>
</div>
