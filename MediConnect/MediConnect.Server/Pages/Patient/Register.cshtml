@page
@model MediConnect.Server.Pages.Patient.RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản bệnh nhân";
}

<div class="min-h-screen bg-[#f6f7f8]">
    <div class="max-w-[860px] mx-auto px-6 py-8 space-y-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6">
            <h1 class="text-4xl font-black">Đăng ký tài khoản bệnh nhân</h1>
            <p class="text-slate-500 mt-2">Bước 1/3 - Thông tin liên hệ</p>
            <div class="mt-4 h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full w-1/3 bg-primary"></div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl px-4 py-3">
                @Model.SuccessMessage
                <a asp-page="/Auth/Login" class="font-semibold text-green-800 no-underline ml-1">Đăng nhập ngay</a>
            </div>
        }

        <form method="post" class="bg-white border border-slate-200 rounded-2xl p-6 space-y-4">
            <div>
                <label asp-for="FullName" class="text-sm text-slate-500"></label>
                <input asp-for="FullName" class="w-full mt-1 rounded-xl border-slate-200" />
                <span asp-validation-for="FullName" class="text-red-500 text-sm"></span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Email" class="text-sm text-slate-500"></label>
                    <input asp-for="Email" class="w-full mt-1 rounded-xl border-slate-200" />
                    <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                </div>
                <div>
                    <label asp-for="PhoneNumber" class="text-sm text-slate-500">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="w-full mt-1 rounded-xl border-slate-200" />
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Password" class="text-sm text-slate-500">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="w-full mt-1 rounded-xl border-slate-200" />
                    <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="text-sm text-slate-500">Nhập lại mật khẩu</label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full mt-1 rounded-xl border-slate-200" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
                </div>
            </div>
            <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm text-blue-700">
                Thông tin của bạn được bảo vệ theo tiêu chuẩn bảo mật của MediConnect.
            </div>
            <div class="flex justify-end gap-3">
                <a asp-page="/Auth/Login" class="px-4 py-2 border border-slate-300 rounded-xl no-underline">Hủy</a>
                <button type="submit" class="px-5 py-2.5 bg-primary text-white rounded-xl font-semibold">Tiếp tục</button>
            </div>
        </form>
    </div>
</div>
