@page
@model MediConnect.Server.Pages.Patient.RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản bệnh nhân";
}

<div class="min-h-screen bg-[#f6f7f8] py-10 px-4">
    <div class="max-w-[640px] mx-auto bg-white rounded-xl border border-[#cfdbe7] overflow-hidden">
        <div class="p-8 pb-4">
            <h1 class="text-4xl font-black tracking-tight">Create Your Patient Account</h1>
            <p class="text-[#4c739a] mt-2">Join our healthcare community to manage your appointments and health records securely.</p>
        </div>

        <div class="px-8 py-4 space-y-3">
            <div class="flex items-center justify-between text-sm">
                <p class="font-semibold">Basic Information</p>
                <p>Step 1 of 3</p>
            </div>
            <div class="rounded-full bg-[#cfdbe7] h-2.5 overflow-hidden">
                <div class="h-2.5 rounded-full bg-primary w-1/3"></div>
            </div>
            <div class="flex items-center gap-2 text-sm text-[#4c739a]"><span class="material-symbols-outlined text-sm">arrow_forward</span>Next: Personal Details</div>
        </div>

        <div class="px-8 py-4">
            <h2 class="text-3xl font-black mb-6">Step 1: Contact Details</h2>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 mb-4">@Model.ErrorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl px-4 py-3 mb-4">
                    @Model.SuccessMessage
                    <a asp-page="/Auth/Login" class="font-semibold text-green-800 no-underline ml-1">Đăng nhập ngay</a>
                </div>
            }

            <form method="post" class="space-y-5">
                <div>
                    <label asp-for="FullName" class="text-sm font-semibold"></label>
                    <input asp-for="FullName" class="w-full h-14 mt-1 rounded-lg border-[#cfdbe7] bg-slate-50" placeholder="e.g. Johnathan Doe" />
                    <span asp-validation-for="FullName" class="text-red-500 text-sm"></span>
                </div>
                <div>
                    <label asp-for="Email" class="text-sm font-semibold"></label>
                    <input asp-for="Email" class="w-full h-14 mt-1 rounded-lg border-[#cfdbe7] bg-slate-50" placeholder="john@example.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                </div>
                <div>
                    <label asp-for="PhoneNumber" class="text-sm font-semibold">Phone Number</label>
                    <input asp-for="PhoneNumber" class="w-full h-14 mt-1 rounded-lg border-[#cfdbe7] bg-slate-50" placeholder="(555) 000-0000" />
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Password" class="text-sm font-semibold">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="w-full h-14 mt-1 rounded-lg border-[#cfdbe7] bg-slate-50" />
                        <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="text-sm font-semibold">Nhập lại mật khẩu</label>
                        <input asp-for="ConfirmPassword" type="password" class="w-full h-14 mt-1 rounded-lg border-[#cfdbe7] bg-slate-50" />
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <div class="p-4 bg-primary/5 rounded-xl border border-primary/20 flex gap-3 items-start text-sm">
                    <span class="material-symbols-outlined text-primary">shield</span>
                    <div>
                        <p class="font-bold">Your privacy is our priority</p>
                        <p class="text-xs text-[#4c739a]">All your healthcare data is encrypted and managed according to HIPAA standards and modern security protocols.</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 mt-8">
                    <a asp-page="/Auth/Login" class="flex-1 h-14 border border-[#cfdbe7] rounded-lg no-underline flex items-center justify-center font-bold text-slate-700">Cancel</a>
                    <button type="submit" class="flex-[2] h-14 bg-primary text-white rounded-lg font-bold shadow-lg shadow-primary/20">Continue to Step 2</button>
                </div>

                <div>
                    <p class="text-[#4c739a] text-xs text-center">By continuing, you agree to HealConnect's <a href="#" class="text-primary">Privacy Policy</a> and <a href="#" class="text-primary">Terms of Service</a>.</p>
                </div>
            </form>
        </div>
    </div>

    <footer class="text-center mt-10">
        <div class="flex items-center justify-center gap-2 text-slate-400 mb-1 text-xs uppercase tracking-widest"><span class="material-symbols-outlined text-sm">lock</span>End-to-End Encrypted Registration</div>
        <p class="text-slate-500 text-sm">© 2024 HealConnect Healthcare Systems. All rights reserved.</p>
    </footer>
</div>

    </div>
</div>
