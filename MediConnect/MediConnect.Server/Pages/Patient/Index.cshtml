@page
@model MediConnect.Server.Pages.Patient.IndexModel
@{
    ViewData["Title"] = "Dashboard Bệnh nhân";
}

<div class="container-fluid py-4 px-3 px-lg-4">
    <!-- AI Alert Banner -->
    <div class="rounded-3 p-3 d-flex align-items-center gap-3 mb-4" style="background:#fffbeb;border:1px solid #fde68a;">
        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px;height:48px;background:#fef3c7;">
            <i class="bi bi-exclamation-triangle-fill" style="color:#d97706;font-size:1.25rem;"></i>
        </div>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-0 small" style="color:#92400e;">Cảnh báo mùa lạnh từ MediConnect AI</h6>
            <p class="mb-0 small" style="color:#78350f;">Nguy cơ bệnh hô hấp đang tăng cao. Hãy tiêm phòng cúm sớm và giữ ấm cơ thể.</p>
        </div>
        <button class="btn btn-sm fw-bold text-white flex-shrink-0" style="background:#d97706;">Xem chi tiết</button>
    </div>

    <!-- AI Hero Banner -->
    <div class="rounded-4 p-5 text-white position-relative overflow-hidden mb-4" style="background:linear-gradient(135deg,var(--mc-primary),#3b82f6);">
        <div class="position-relative" style="z-index:1;max-width:600px;">
            <span class="badge rounded-pill mb-3" style="background:rgba(255,255,255,0.2);backdrop-filter:blur(10px);">
                <i class="bi bi-stars"></i> Trí tuệ nhân tạo y tế
            </span>
            <h1 class="fw-bold mb-3" style="font-size:2rem;">Hỗ trợ sức khỏe thông minh</h1>
            <p class="mb-4" style="color:#bfdbfe;font-size:1.05rem;">
                Sử dụng MediConnect AI để phân tích hồ sơ bệnh án, nhắc nhở lịch khám và nhận gợi ý chăm sóc sức khỏe cá nhân hóa.
            </p>
            <a href="#" class="btn bg-white fw-bold px-4 py-2" style="color:var(--mc-primary);">
                Xem báo cáo sức khỏe AI
            </a>
        </div>
        <div class="position-absolute" style="right:-20px;bottom:-40px;opacity:0.1;font-size:280px;line-height:1;">
            <i class="bi bi-activity"></i>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="d-flex gap-2 flex-wrap mb-4">
        <a asp-page="/Doctors/Index" class="btn btn-mc-outline rounded-pill d-flex align-items-center gap-2 px-4">
            <i class="bi bi-search-heart"></i> Tìm bác sĩ nhanh
        </a>
        <a asp-page="/Appointments/Index" class="btn btn-mc-outline rounded-pill d-flex align-items-center gap-2 px-4">
            <i class="bi bi-calendar-check"></i> Lịch hẹn của tôi
        </a>
        <a href="#" class="btn btn-mc-outline rounded-pill d-flex align-items-center gap-2 px-4">
            <i class="bi bi-clipboard2-pulse"></i> Kiểm tra triệu chứng
        </a>
    </div>

    <!-- Greeting + Suggestions -->
    <div class="bg-white rounded-4 border p-4 mb-4 d-flex flex-column flex-md-row align-items-center gap-4" style="border-color:var(--mc-border);">
        <div class="d-flex align-items-center gap-3 pb-3 pb-md-0 pe-md-4 border-bottom border-md-bottom-0 border-md-end flex-shrink-0" style="border-color:var(--mc-border);">
            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                <i class="bi bi-person-circle" style="font-size:2rem;color:var(--mc-text-muted);"></i>
            </div>
            <div>
                <p class="small mb-0" style="color:var(--mc-text-muted);">Xin chào,</p>
                <h5 class="fw-bold mb-0">@Model.CurrentUser?.FullName</h5>
            </div>
        </div>
        <div class="flex-grow-1">
            <div class="row g-3">
                @foreach (var s in Model.SuggestedSpecialties.Take(4))
                {
                    <div class="col-6 col-md-3">
                        <div class="rounded-3 p-3 border text-center" style="background:#f8fafc;border-color:var(--mc-border);cursor:pointer;">
                            <div class="small fw-bold mb-1" style="color:var(--mc-primary);">Gợi ý</div>
                            <div class="small fw-semibold">@s.SpecialtyName</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Calendar Section -->
    <div class="bg-white rounded-4 border mb-4 overflow-hidden" style="border-color:var(--mc-border);">
        <div class="d-flex align-items-center justify-content-between p-3 border-bottom" style="background:#f8fafc;border-color:var(--mc-border);">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-calendar3 text-primary"></i>
                <span class="fw-bold" style="color:var(--mc-text);">Lịch khám của bạn</span>
            </div>
            <div class="d-flex gap-2 align-items-center small">
                <span class="d-flex align-items-center gap-1"><span class="rounded" style="width:12px;height:12px;background:var(--mc-primary);display:inline-block;"></span> Sắp tới</span>
                <span class="d-flex align-items-center gap-1"><span class="rounded" style="width:12px;height:12px;background:#94a3b8;display:inline-block;"></span> Đã khám</span>
                <span class="d-flex align-items-center gap-1"><span class="rounded" style="width:12px;height:12px;background:#ef4444;display:inline-block;"></span> Đã hủy</span>
            </div>
        </div>
        <div class="p-4">
            @if (Model.UpcomingAppointments.Any())
            {
                <div class="row g-3">
                    @foreach (var apt in Model.UpcomingAppointments.Take(5))
                    {
                        var statusClass = apt.Status == "CONFIRMED" ? "border-primary bg-primary bg-opacity-10" :
                                          apt.Status == "CANCELLED" ? "border-danger bg-danger bg-opacity-10" : "border-secondary bg-light";
                        <div class="col-md-4 col-lg-3">
                            <div class="rounded-3 p-3 border-start border-3 @statusClass">
                                <div class="fw-bold small">@apt.StartTime.ToString("HH:mm")</div>
                                <div class="small text-truncate">@apt.Reason</div>
                                <div class="small" style="color:var(--mc-text-muted);">@apt.AppointmentDate.ToString("dd/MM")</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4" style="color:var(--mc-text-muted);">
                    <i class="bi bi-calendar-x" style="font-size:2rem;"></i>
                    <p class="small mt-2 mb-0">Chưa có lịch hẹn nào.</p>
                    <a asp-page="/Doctors/Index" class="btn btn-mc-primary btn-sm mt-2">Đặt lịch ngay</a>
                </div>
            }
        </div>
    </div>

    <!-- AI Health Reminders -->
    <div class="rounded-4 p-4 mb-4 position-relative overflow-hidden" style="background:var(--mc-primary-light);border:1px solid rgba(19,127,236,0.2);">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width:40px;height:40px;background:var(--mc-primary);">
                <i class="bi bi-stars"></i>
            </div>
            <h5 class="fw-bold mb-0">Nhắc nhở Sức khỏe AI</h5>
        </div>
        <div class="row g-3">
            @if (Model.AiRecommendations.Any())
            {
                @foreach (var rec in Model.AiRecommendations.Take(2))
                {
                    <div class="col-md-6">
                        <div class="bg-white rounded-3 p-3 border d-flex gap-3" style="border-color:rgba(19,127,236,0.1);">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;background:#eff6ff;">
                                <i class="bi bi-bell text-primary"></i>
                            </div>
                            <div>
                                <div class="small fw-bold text-primary text-uppercase mb-1" style="letter-spacing:0.05em;">Gợi ý AI</div>
                                <div class="small fw-semibold">@rec.InputSymptoms</div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-6">
                    <div class="bg-white rounded-3 p-3 border d-flex gap-3" style="border-color:rgba(19,127,236,0.1);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;background:#eff6ff;">
                            <i class="bi bi-bell text-primary"></i>
                        </div>
                        <div>
                            <div class="small fw-bold text-primary text-uppercase mb-1">Nhắc nhở</div>
                            <div class="small fw-semibold">Hãy đặt lịch khám sức khỏe định kỳ để theo dõi sức khỏe toàn diện.</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="bg-white rounded-3 p-3 border d-flex gap-3" style="border-color:rgba(19,127,236,0.1);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;background:#ecfdf5;">
                            <i class="bi bi-graph-up text-success"></i>
                        </div>
                        <div>
                            <div class="small fw-bold text-success text-uppercase mb-1">Khuyến cáo</div>
                            <div class="small fw-semibold">Theo dõi chỉ số sức khỏe hàng ngày để đảm bảo ổn định.</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Promotions -->
    @if (Model.Promotions.Any())
    {
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0">Dịch vụ Khuyến mãi</h5>
                <a href="#" class="text-decoration-none fw-semibold small" style="color:var(--mc-primary);">Tất cả ưu đãi</a>
            </div>
            <div class="row g-3">
                @foreach (var promo in Model.Promotions.Take(3))
                {
                    <div class="col-md-4">
                        <div class="bg-white rounded-4 border overflow-hidden h-100" style="border-color:var(--mc-border);">
                            <div class="p-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge rounded-pill" style="background:var(--mc-primary-light);color:var(--mc-primary);font-size:0.65rem;">Khuyến mãi</span>
                                    @if (promo.EndDate.HasValue)
                                    {
                                        <span class="small" style="color:var(--mc-text-muted);">Đến @promo.EndDate.Value.ToString("dd/MM")</span>
                                    }
                                </div>
                                <h6 class="fw-bold">@promo.Title</h6>
                                <p class="small mb-0" style="color:var(--mc-text-muted);">@promo.Message</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Services Grid -->
    <h5 class="fw-bold mb-3">Dịch vụ toàn diện</h5>
    <div class="row g-3 mb-4">
        @{
            var services = new[] {
                ("bi-clipboard2-pulse", "Khám Chuyên khoa"),
                ("bi-camera-video", "Khám từ xa"),
                ("bi-file-medical", "Khám tổng quát"),
                ("bi-droplet", "Xét nghiệm"),
                ("bi-emoji-smile", "Tâm thần"),
                ("bi-emoji-laughing", "Nha khoa"),
                ("bi-scissors", "Gói phẫu thuật"),
                ("bi-heart-pulse", "Test sức khỏe")
            };
        }
        @foreach (var (icon, name) in services)
        {
            <div class="col-6 col-sm-3 col-lg">
                <div class="bg-white rounded-3 border p-3 text-center" style="border-color:var(--mc-border);cursor:pointer;">
                    <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-2" style="width:48px;height:48px;background:#eff6ff;">
                        <i class="bi @icon text-primary" style="font-size:1.25rem;"></i>
                    </div>
                    <div class="small fw-bold">@name</div>
                </div>
            </div>
        }
    </div>

    <!-- Featured Doctors -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold mb-0">Bác sĩ nổi bật</h5>
        <a asp-page="/Doctors/Index" class="text-decoration-none fw-semibold small" style="color:var(--mc-primary);">Xem tất cả</a>
    </div>
    <div class="row g-3 mb-4">
        @foreach (var doc in Model.FeaturedDoctors.Take(4))
        {
            <div class="col-md-6 col-lg-3">
                <div class="bg-white rounded-4 border p-3 h-100" style="border-color:var(--mc-border);">
                    <div class="d-flex gap-3 mb-3">
                        <div class="rounded-3 bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="width:64px;height:64px;">
                            @if (!string.IsNullOrEmpty(doc.User.AvatarUrl))
                            {
                                <img src="@doc.User.AvatarUrl" class="rounded-3" style="width:64px;height:64px;object-fit:cover;" alt="" />
                            }
                            else
                            {
                                <i class="bi bi-person" style="font-size:1.5rem;color:var(--mc-text-muted);"></i>
                            }
                        </div>
                        <div class="min-w-0">
                            <span class="badge rounded-pill mb-1" style="background:var(--mc-primary-light);color:var(--mc-primary);font-size:0.6rem;">
                                @(doc.Department?.DepartmentName ?? "Đa khoa")
                            </span>
                            <h6 class="fw-bold mb-0 text-truncate">@doc.User.FullName</h6>
                            <div class="d-flex align-items-center gap-1 small" style="color:#f59e0b;">
                                <i class="bi bi-star-fill"></i> @doc.AverageRating.ToString("F1")
                            </div>
                        </div>
                    </div>
                    <div class="small" style="color:var(--mc-text-muted);">@doc.YearsOfExperience năm kinh nghiệm</div>
                    <a asp-page="/Doctors/Details" asp-route-id="@doc.DoctorProfileId" class="btn btn-mc-primary btn-sm w-100 mt-2">Đặt lịch</a>
                </div>
            </div>
        }
    </div>
</div>
