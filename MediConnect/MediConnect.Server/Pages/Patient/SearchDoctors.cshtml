@page
@model MediConnect.Server.Pages.Patient.SearchDoctorsModel
@{
    ViewData["Title"] = "Tìm & lọc bác sĩ";
}

<div class="max-w-[1440px] mx-auto px-6 lg:px-12 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
        <aside class="w-full lg:w-72 shrink-0">
            <div class="sticky top-24 bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-bold">Bộ lọc</h2>
                    <a asp-page="/Patient/SearchDoctors" class="text-primary text-xs font-bold uppercase tracking-wider no-underline">Đặt lại</a>
                </div>

                <form method="get" class="space-y-4">
                    <div class="p-3 bg-primary/5 border border-primary/20 rounded-lg">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-xl">auto_awesome</span><span class="text-sm font-bold">Gợi ý thông minh</span></div>
                            <input type="checkbox" checked class="rounded text-primary" />
                        </div>
                        <p class="text-[10px] text-slate-500 mt-1">Tối ưu hóa gợi ý dựa trên triệu chứng của bạn</p>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-widest text-slate-500">Từ khóa</label>
                        <input asp-for="SearchTerm" class="w-full mt-2 rounded-lg border-slate-200 bg-slate-50" placeholder="Tên bác sĩ, chuyên khoa..." />
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-widest text-slate-500">Chuyên khoa</label>
                        <select asp-for="SpecialtyId" asp-items="Model.SpecialtyList" class="w-full mt-2 rounded-lg border-slate-200 bg-slate-50">
                            <option value="">Tất cả</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-widest text-slate-500">Khoa</label>
                        <select asp-for="DepartmentId" asp-items="Model.DepartmentList" class="w-full mt-2 rounded-lg border-slate-200 bg-slate-50">
                            <option value="">Tất cả</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-widest text-slate-500">Đánh giá</label>
                        <select asp-for="MinRating" class="w-full mt-2 rounded-lg border-slate-200 bg-slate-50">
                            <option value="">Bất kỳ</option>
                            <option value="4">4.0+ Sao</option>
                            <option value="4.5">4.5+ Sao</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-widest text-slate-500">Bảo hiểm</label>
                        <input asp-for="Insurance" class="w-full mt-2 rounded-lg border-slate-200 bg-slate-50" placeholder="Aetna, BHYT..." />
                    </div>

                    <button type="submit" class="w-full py-3 bg-primary text-white rounded-lg font-bold">Áp dụng bộ lọc</button>
                </form>
            </div>
        </aside>

        <section class="flex-1">
            <nav class="flex items-center gap-2 mb-4 text-sm font-medium text-slate-500">
                <a href="#" class="hover:text-primary no-underline">Trang chủ</a><span>/</span><span class="text-slate-900">Tìm kiếm MediConnect</span>
            </nav>

            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
                <div>
                    <h1 class="text-4xl font-black tracking-tight">@Model.Doctors.Count Bác sĩ phù hợp với hồ sơ của bạn</h1>
                    <p class="text-slate-500 mt-1">Xếp hạng gợi ý cho kết quả tìm kiếm theo bộ lọc hiện tại</p>
                </div>
                <button class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold">Điểm phù hợp</button>
            </div>

            <div class="flex flex-wrap gap-2 mb-6">
                <span class="px-3 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-bold border border-primary/20">Gợi ý đang bật</span>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <span class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-full text-xs font-bold border border-slate-200">@Model.SearchTerm</span>
                }
                <span class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-full text-xs font-bold border border-slate-200">7 ngày tới</span>
            </div>

            <div class="grid grid-cols-1 gap-6">
            @foreach (var doctor in Model.Doctors)
            {
                <div class="bg-white border border-slate-200 rounded-xl p-6 border-l-4 border-l-primary relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-primary text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase">@(Math.Clamp((int)(doctor.AverageRating * 20), 80, 99))% Phù hợp</div>
                    <div class="flex flex-col xl:flex-row gap-6">
                        <div class="flex-1">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <h2 class="text-3xl font-bold">@doctor.FullName</h2>
                                    <p class="text-primary text-sm font-bold mt-1">@string.Join(" • ", doctor.Specialties)</p>
                                </div>
                                <p class="text-sm font-bold">⭐ @doctor.AverageRating.ToString("0.0") (@doctor.TotalReviews đánh giá)</p>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-2 text-sm text-slate-500 mt-4">
                                <p class="flex items-center gap-2"><span class="material-symbols-outlined text-base">location_on</span>Vị trí: @(doctor.Location ?? "Chưa cập nhật")</p>
                                <p class="flex items-center gap-2"><span class="material-symbols-outlined text-base">payments</span>Phí khám: @doctor.ConsultationFee.ToString("N0")đ / lượt</p>
                                <p class="flex items-center gap-2"><span class="material-symbols-outlined text-base">business</span>Khoa: @(doctor.DepartmentName ?? "Chưa cập nhật")</p>
                                <p class="flex items-center gap-2"><span class="material-symbols-outlined text-base">health_and_safety</span>Bảo hiểm: @(string.IsNullOrWhiteSpace(doctor.InsuranceAccepted) ? "Chưa cập nhật" : doctor.InsuranceAccepted)</p>
                            </div>
                        </div>

                        <div class="flex flex-row xl:flex-col gap-3 min-w-[170px]">
                            <a asp-page="/Patient/DoctorProfile" asp-route-doctorProfileId="@doctor.DoctorProfileId" class="flex-1 px-6 py-2.5 bg-primary text-white font-bold rounded-lg text-sm no-underline text-center">Đặt lịch ngay</a>
                            <a asp-page="/Patient/DoctorProfile" asp-route-doctorProfileId="@doctor.DoctorProfileId" class="flex-1 px-6 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-lg text-sm no-underline text-center">Xem hồ sơ</a>
                            <a asp-page="/Patient/DoctorSchedule" asp-route-doctorUserId="@doctor.UserId" class="flex-1 px-6 py-2.5 border border-slate-200 text-slate-700 font-bold rounded-lg text-sm no-underline text-center">Lịch 7 ngày</a>
                        </div>
                    </div>

                    <div class="mt-5 border-t border-slate-100 pt-4">
                        <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">Lịch trống trong 7 ngày tới</p>
                        <div class="grid grid-cols-4 md:grid-cols-8 gap-2">
                            <span class="text-center py-1.5 bg-slate-50 rounded text-xs">08:30</span>
                            <span class="text-center py-1.5 bg-slate-50 rounded text-xs">10:00</span>
                            <span class="text-center py-1.5 bg-slate-50 rounded text-xs">11:30</span>
                            <span class="text-center py-1.5 bg-slate-50 rounded text-xs">14:00</span>
                            <span class="text-center py-1.5 bg-slate-50 rounded text-xs">15:30</span>
                            <span class="text-center py-1.5 bg-slate-50 rounded text-xs">16:00</span>
                            <span class="text-center py-1.5 bg-slate-50 rounded text-xs">17:00</span>
                            <span class="text-center py-1.5 bg-slate-50 rounded text-xs">18:00</span>
                        </div>
                    </div>
                </div>
            }
            </div>
        </section>
    </div>
</div>
