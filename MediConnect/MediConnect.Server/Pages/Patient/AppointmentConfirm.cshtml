@page
@model MediConnect.Server.Pages.Patient.AppointmentConfirmModel
@{
    ViewData["Title"] = "Xác nhận lịch hẹn";
}

<div class="max-w-[1280px] mx-auto px-6 py-8">
    <h1 class="text-3xl font-black mb-6">Xác nhận & Thanh toán</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-4 p-3 rounded-lg bg-red-50 text-red-600">@Model.ErrorMessage</div>
    }

    <form method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <input asp-for="DoctorUserId" type="hidden" />

        <div class="lg:col-span-2 space-y-4">
            <div class="bg-white border border-slate-200 rounded-xl p-5">
                <h2 class="text-lg font-bold mb-4">Thông tin bệnh nhân</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm text-slate-500">Ngày hẹn</label>
                        <input asp-for="AppointmentDate" type="date" class="w-full mt-1 rounded-lg border-slate-200" />
                    </div>
                    <div>
                        <label class="text-sm text-slate-500">Chuyên khoa</label>
                        <select asp-for="SpecialtyId" asp-items="Model.SpecialtyList" class="w-full mt-1 rounded-lg border-slate-200">
                            <option value="">Không chọn</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-xl p-5">
                <h2 class="text-lg font-bold mb-4">Tình trạng sức khỏe</h2>
                <label class="text-sm text-slate-500">Triệu chứng / Lý do khám</label>
                <textarea asp-for="Reason" rows="3" class="w-full mt-1 rounded-lg border-slate-200" placeholder="Ví dụ: ho khan, tức ngực..."></textarea>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-xl p-5 h-fit">
            <h2 class="text-lg font-bold">Tóm tắt lịch hẹn</h2>
            <div class="mt-3 text-sm text-slate-600">
                <p class="font-semibold text-[#0d141b]">@(Model.Doctor?.FullName ?? "Bác sĩ")</p>
                <p>@Model.Doctor?.DepartmentName</p>
                <p class="mt-1">Phí khám: @(Model.Doctor?.ConsultationFee.ToString("N0") ?? "0")đ</p>
            </div>

            <div class="mt-4">
                <label class="text-sm text-slate-500">Khung giờ trống</label>
                <select asp-for="SlotId" asp-items="Model.SlotList" class="w-full mt-1 rounded-lg border-slate-200"></select>
            </div>

            <button type="submit" class="w-full mt-5 py-3 bg-primary text-white rounded-lg font-semibold">Xác nhận & Thanh toán</button>
            <a asp-page="/Patient/DoctorSearch" class="block text-center mt-2 text-slate-500 text-sm no-underline">Quay lại</a>
        </div>
    </form>
</div>
