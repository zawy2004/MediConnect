@page
@model MediConnect.Server.Pages.Patient.BookingSuccessModel
@{
    ViewData["Title"] = "Đặt lịch thành công";
}

@if (Model.Data != null)
{
    <div class="max-w-[920px] mx-auto px-6 py-10">
        <div class="bg-white border border-green-200 rounded-2xl p-8 text-center space-y-4">
            <div class="size-16 mx-auto rounded-full bg-green-100 text-green-700 flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">check</span>
            </div>
            <h1 class="text-4xl font-black">Đặt lịch thành công!</h1>
            <p class="text-slate-500">Mã lịch hẹn #@Model.Data.AppointmentId • Mã giao dịch @Model.Data.TransactionId</p>

            <div class="bg-slate-50 rounded-xl p-4 text-left max-w-[520px] mx-auto text-sm text-slate-700 space-y-2">
                <p><span class="text-slate-500">Bác sĩ:</span> @Model.Data.DoctorName</p>
                <p><span class="text-slate-500">Thời gian:</span> @Model.Data.AppointmentDate.ToString("dd/MM/yyyy") @Model.Data.StartTime.ToString("HH:mm")</p>
                <p><span class="text-slate-500">Trạng thái:</span> @Model.Data.Status</p>
            </div>

            <div class="flex justify-center gap-3 pt-2">
                <a asp-page="/Patient/Appointments" class="px-4 py-2 border border-slate-300 rounded-xl no-underline">Xem lịch hẹn</a>
                <a asp-page="/Patient/Dashboard" class="px-4 py-2 bg-primary text-white rounded-xl no-underline">Về dashboard</a>
            </div>
        </div>
    </div>
}
