@page
@model MediConnect.Server.Pages.Patient.DoctorScheduleModel
@{
    ViewData["Title"] = "Lịch bác sĩ";
}

@if (Model.Data != null)
{
    var available = Model.Data.Slots.Where(x => x.IsAvailable).OrderBy(x => x.SlotDate).ThenBy(x => x.StartTime).ToList();
    var grouped = Model.Data.Slots.OrderBy(x => x.SlotDate).ThenBy(x => x.StartTime).GroupBy(x => x.SlotDate).ToList();
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 px-6 lg:px-12 py-8">
        <div class="lg:col-span-8">
            <div class="mb-6">
                <h1 class="text-4xl font-black tracking-tight">Tìm kiếm bác sĩ MediConnect</h1>
                <p class="text-slate-500 mt-1">Lịch của @Model.Data.DoctorName từ @Model.Data.FromDate.ToString("dd/MM") đến @Model.Data.ToDate.ToString("dd/MM/yyyy")</p>
            </div>

            <div class="flex flex-wrap items-center gap-2 mb-4">
                <span class="px-3 py-1.5 bg-slate-900 text-white rounded-full text-[10px] font-black uppercase tracking-widest">Logic xếp hạng gợi ý</span>
                <span class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-full text-xs font-bold">Phù hợp chuyên khoa (30%)</span>
                <span class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-full text-xs font-bold">Kinh nghiệm (20%)</span>
                <span class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-full text-xs font-bold">Đánh giá (20%)</span>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
                    <h3 class="font-bold text-lg">Lịch trong tuần</h3>
                    <div class="flex bg-slate-100 p-1 rounded-xl">
                        <button class="px-4 py-1.5 text-xs font-bold rounded-lg text-slate-500">Tháng</button>
                        <button class="px-4 py-1.5 text-xs font-bold bg-white shadow-sm rounded-lg text-primary">Tuần</button>
                        <button class="px-4 py-1.5 text-xs font-bold rounded-lg text-slate-500">Ngày</button>
                    </div>
                </div>

                <div class="p-5">
                    <div class="space-y-4">
                        @foreach (var day in grouped)
                        {
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">@day.Key.ToString("dddd, dd/MM/yyyy")</p>
                                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-2">
                                    @foreach (var slot in day)
                                    {
                                        <div class="p-2 rounded-lg border text-center @(slot.IsAvailable ? "border-blue-200 bg-blue-50 text-blue-700" : "border-red-200 bg-red-50 text-red-600")">
                                            <p class="font-bold text-xs">@slot.StartTime.ToString("HH:mm")</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4 flex gap-6 text-sm">
                <div class="flex items-center gap-2"><div class="w-4 h-4 bg-blue-50 border border-blue-200 rounded"></div><span class="font-bold text-slate-600">Bác sĩ có sẵn</span></div>
                <div class="flex items-center gap-2"><div class="w-4 h-4 bg-red-50 border border-red-200 rounded"></div><span class="font-bold text-slate-600">Đã kín lịch</span></div>
            </div>
        </div>

        <aside class="lg:col-span-4 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-extrabold">Xếp hạng gợi ý hàng đầu</h2>
                <span class="px-3 py-1 bg-primary text-white rounded-lg text-[11px] font-black uppercase">T4, 08:00 AM</span>
            </div>

            <div class="bg-white rounded-2xl border-2 border-primary p-5 shadow-lg">
                <div class="flex items-start justify-between">
                    <div>
                        <h3 class="font-extrabold text-lg">@Model.Data.DoctorName</h3>
                        <p class="text-primary text-xs font-bold">Bác sĩ được đề xuất cao</p>
                        <p class="text-xs mt-1 text-slate-500">Dựa trên lịch trống và điểm phù hợp hiện tại</p>
                    </div>
                    <span class="text-xs font-black text-primary">98%</span>
                </div>

                <div class="mt-4 space-y-2">
                    @foreach (var slot in available.Take(4))
                    {
                        <div class="flex items-center justify-between px-3 py-2 bg-slate-50 rounded-lg">
                            <span class="text-sm font-semibold">@slot.SlotDate.ToString("dd/MM") @slot.StartTime.ToString("HH:mm")</span>
                            <span class="text-xs text-primary font-bold">Trống</span>
                        </div>
                    }
                </div>

                <a asp-page="/Patient/SearchDoctors" class="block mt-4 py-3 bg-primary text-white rounded-xl text-center font-bold no-underline">Quay lại tìm bác sĩ</a>
            </div>
        </aside>
    </div>
}
