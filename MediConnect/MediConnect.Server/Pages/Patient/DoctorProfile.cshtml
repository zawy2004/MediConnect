@page
@model MediConnect.Server.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Hồ sơ bác sĩ & đặt lịch";
}

@if (Model.Data?.Doctor != null)
{
    var doctor = Model.Data.Doctor;
    <div class="max-w-[1280px] mx-auto w-full px-6 py-8">
        <div class="flex flex-wrap gap-2 mb-6 text-sm text-slate-500">
            <a asp-page="/Patient/Dashboard" class="hover:text-primary no-underline">Trang chủ</a>
            <span>/</span>
            <a asp-page="/Patient/SearchDoctors" class="hover:text-primary no-underline">Bác sĩ</a>
            <span>/</span>
            <span class="font-bold text-slate-900">@doctor.FullName</span>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">
            <section class="flex-1 space-y-6">
                <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
                    <div class="flex flex-col md:flex-row gap-6">
                        <div class="w-40 h-40 rounded-xl bg-slate-100 border"></div>
                        <div class="flex-1">
                            <h1 class="text-4xl font-black">@doctor.FullName</h1>
                            <p class="text-primary font-semibold text-lg">@string.Join(", ", doctor.Specialties)</p>
                            <p class="text-slate-500 mt-2 flex items-center gap-2"><span class="material-symbols-outlined text-sm">location_on</span>@(doctor.Location ?? "Chưa cập nhật địa điểm")</p>
                            <div class="flex items-center gap-2 mt-3 text-yellow-500">
                                <span class="material-symbols-outlined">star</span><span class="material-symbols-outlined">star</span><span class="material-symbols-outlined">star</span><span class="material-symbols-outlined">star</span><span class="material-symbols-outlined text-slate-300">star</span>
                                <span class="text-slate-800 font-bold ml-2">@doctor.AverageRating.ToString("0.0")</span>
                                <span class="text-slate-500 text-sm">(@doctor.TotalReviews đánh giá)</span>
                            </div>
                        </div>

                        <div class="flex flex-col gap-2 min-w-[140px]">
                            <button class="rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold">Lưu</button>
                            <button class="rounded-lg h-10 px-4 bg-[#e7edf3] text-slate-700 text-sm font-bold">Chia sẻ</button>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-4">
                    <div class="flex min-w-[140px] flex-1 flex-col gap-1 rounded-xl border border-slate-200 bg-white p-4"><p class="text-primary text-3xl font-black">@doctor.YearsOfExperience+</p><p class="text-xs font-bold text-slate-500 uppercase">Năm kinh nghiệm</p></div>
                    <div class="flex min-w-[140px] flex-1 flex-col gap-1 rounded-xl border border-slate-200 bg-white p-4"><p class="text-primary text-3xl font-black">@Model.Data.TotalVisits</p><p class="text-xs font-bold text-slate-500 uppercase">Lượt khám</p></div>
                    <div class="flex min-w-[140px] flex-1 flex-col gap-1 rounded-xl border border-slate-200 bg-white p-4"><p class="text-primary text-3xl font-black">@Model.Data.SatisfiedPercent%</p><p class="text-xs font-bold text-slate-500 uppercase">Hài lòng</p></div>
                    <div class="flex min-w-[140px] flex-1 flex-col gap-1 rounded-xl border border-slate-200 bg-white p-4"><p class="text-primary text-3xl font-black">@Model.Data.AwardsCount+</p><p class="text-xs font-bold text-slate-500 uppercase">Giải thưởng</p></div>
                </div>

                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
                    <div class="flex border-b border-slate-200 px-6 gap-8 overflow-x-auto">
                        <span class="border-b-[3px] border-primary text-primary pb-[13px] pt-4 text-sm font-bold whitespace-nowrap">Giới thiệu</span>
                        <span class="pb-[13px] pt-4 text-sm font-bold text-slate-400 whitespace-nowrap">Kinh nghiệm</span>
                        <span class="pb-[13px] pt-4 text-sm font-bold text-slate-400 whitespace-nowrap">Đánh giá</span>
                        <span class="pb-[13px] pt-4 text-sm font-bold text-slate-400 whitespace-nowrap">Bệnh viện liên kết</span>
                    </div>
                    <div class="p-8 space-y-6">
                        <div>
                            <h3 class="text-xl font-bold">Tiểu sử</h3>
                            <p class="text-slate-600 leading-relaxed mt-3">@doctor.Bio</p>
                        </div>
                        <div class="grid md:grid-cols-2 gap-8">
                            <div class="space-y-3">
                                <h3 class="text-lg font-bold flex items-center gap-2"><span class="material-symbols-outlined text-primary">school</span>Học vấn</h3>
                                <ul class="space-y-2 text-slate-500">
                                    <li class="flex flex-col"><span class="font-bold text-slate-900">@(doctor.Education ?? "Chưa cập nhật")</span><span class="text-sm">Đào tạo chuyên môn</span></li>
                                    <li class="flex flex-col"><span class="font-bold text-slate-900">@(doctor.DepartmentName ?? "MediConnect")</span><span class="text-sm">Đơn vị công tác</span></li>
                                </ul>
                            </div>
                            <div class="space-y-3">
                                <h3 class="text-lg font-bold flex items-center gap-2"><span class="material-symbols-outlined text-primary">psychiatry</span>Chuyên môn</h3>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var sp in doctor.Specialties)
                                    {
                                        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">@sp</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl p-8 border border-slate-200 shadow-sm space-y-6">
                    <div class="flex justify-between items-center"><h3 class="text-xl font-bold">Đánh giá của bệnh nhân</h3><button class="text-primary font-bold text-sm">Xem tất cả</button></div>
                    @foreach (var review in doctor.RecentReviews)
                    {
                        <div class="border-b border-slate-100 pb-4 last:border-b-0">
                            <div class="flex justify-between mb-2">
                                <div>
                                    <p class="font-bold">@review.PatientName</p>
                                    <p class="text-xs text-slate-400">@review.CreatedAt.ToString("dd/MM/yyyy")</p>
                                </div>
                                <span class="text-sm font-bold text-yellow-500">⭐ @review.Rating.ToString("0.0")</span>
                            </div>
                            <p class="text-sm text-slate-600 italic">"@review.Comment"</p>
                        </div>
                    }
                    @if (doctor.RecentReviews.Count == 0)
                    {
                        <p class="text-sm text-slate-500">Chưa có đánh giá hiển thị.</p>
                    }
                </div>
            </section>

            <aside class="w-full lg:w-[380px] space-y-4">
                <div class="bg-white rounded-xl border border-primary/30 shadow-xl overflow-hidden sticky top-6">
                    <div class="bg-primary p-4 text-white">
                        <h3 class="text-lg font-bold">Đặt lịch khám</h3>
                        <p class="text-xs opacity-90">Khả dụng theo thời gian thực</p>
                    </div>

                    <div class="p-6 space-y-4">
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-3 py-2 text-sm">@Model.ErrorMessage</div>
                        }

                        <form method="post" asp-page-handler="Book" class="space-y-4">
                            <input asp-for="DoctorProfileId" type="hidden" />

                            <div>
                                <label asp-for="SlotId" class="text-sm font-bold">Khung giờ trống</label>
                                <select asp-for="SlotId" class="w-full mt-2 rounded-xl border-slate-200">
                                    <option value="">Chọn khung giờ</option>
                                    @foreach (var slot in Model.Data.NextSlots)
                                    {
                                        <option value="@slot.SlotId">@slot.SlotDate.ToString("dd/MM") • @slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</option>
                                    }
                                </select>
                                <span asp-validation-for="SlotId" class="text-red-500 text-sm"></span>
                            </div>

                            <div>
                                <label asp-for="Reason" class="text-sm font-bold">Triệu chứng/Lý do khám</label>
                                <textarea asp-for="Reason" rows="3" class="w-full mt-2 rounded-xl border-slate-200" placeholder="Mô tả ngắn triệu chứng"></textarea>
                            </div>

                            <div class="pt-3 border-t border-slate-100 space-y-2">
                                <div class="flex justify-between text-sm"><span class="text-slate-500">Phí khám</span><span class="font-bold">@doctor.ConsultationFee.ToString("N0")đ</span></div>
                                <div class="flex justify-between text-sm"><span class="text-slate-500">Phí dịch vụ</span><span class="font-bold">10.000đ</span></div>
                                <div class="flex justify-between text-lg"><span class="font-bold">Tổng cộng</span><span class="font-black text-primary">@((doctor.ConsultationFee + 10000).ToString("N0"))đ</span></div>
                            </div>

                            <button type="submit" class="w-full bg-primary text-white py-4 rounded-xl font-bold text-sm shadow-lg shadow-primary/30 flex items-center justify-center gap-2">Tiến hành thanh toán <span class="material-symbols-outlined text-sm">arrow_forward</span></button>
                        </form>
                    </div>
                </div>

                <a asp-page="/Patient/DoctorSchedule" asp-route-doctorUserId="@doctor.UserId" class="block text-center py-3 rounded-xl border border-slate-300 no-underline bg-white font-semibold">Xem lịch tổng quát</a>
            </aside>
        </div>
    </div>
}
