@page
@model MediConnect.Server.Pages.Patient.SymptomAssessmentModel
@{
    ViewData["Title"] = "Đánh giá triệu chứng";
}

<main class="max-w-7xl mx-auto w-full px-6 py-6">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-6 flex items-center gap-2 text-sm">
        <a asp-page="/Patient/Dashboard" class="text-slate-500 hover:text-primary no-underline transition-colors">Dashboard</a>
        <span class="material-symbols-outlined text-slate-400 text-sm">chevron_right</span>
        <a asp-page="/Patient/DoctorSearch" class="text-slate-500 hover:text-primary no-underline transition-colors">Tìm bác sĩ</a>
        <span class="material-symbols-outlined text-slate-400 text-sm">chevron_right</span>
        <span class="text-slate-900 font-semibold">Gợi ý thông minh</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <div class="lg:col-span-2">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-5xl font-black leading-tight">Trợ lý đánh giá triệu chứng</h2>
                    <p class="text-slate-500 mt-1 flex items-center gap-2"><span class="material-symbols-outlined text-sm text-emerald-500">lock</span>Phiên phân loại y tế bảo mật và tuân thủ tiêu chuẩn an toàn dữ liệu</p>
                </div>
                <div class="min-w-[240px]">
                    <div class="flex justify-between text-xs font-bold uppercase tracking-wider text-slate-400"><span>Tiến trình phân tích</span><span id="riskScoreText">@(Model.Result?.RiskScore ?? 20)%</span></div>
                    <div class="h-2 w-full bg-slate-200 rounded-full overflow-hidden mt-2"><div id="riskScoreBar" class="h-full bg-primary transition-all duration-500" style="width:@(Model.Result?.RiskScore ?? 20)%"></div></div>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
                <div class="p-6 space-y-6 min-h-[420px] max-h-[500px] overflow-y-auto" id="chatContainer">
                    <div id="chatThread" class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary border border-primary/20"><span class="material-symbols-outlined">smart_toy</span></div>
                            <div class="max-w-[85%]">
                                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Trợ lý MediConnect</span>
                                <div class="bg-slate-100 p-4 rounded-xl rounded-tl-none text-sm mt-1">Chào bạn! Mình là trợ lý sức khỏe MediConnect. Bạn hãy mô tả triệu chứng, mình sẽ phân tích và gợi ý hướng khám phù hợp.</div>
                            </div>
                        </div>

                        @if (Model.Result != null && !string.IsNullOrWhiteSpace(Model.Result.SymptomText))
                        {
                            <div class="flex items-start gap-4 flex-row-reverse">
                                <div class="w-10 h-10 rounded-full bg-slate-200"></div>
                                <div class="max-w-[85%] text-right">
                                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Bạn</span>
                                    <div class="bg-primary text-white p-4 rounded-xl rounded-tr-none text-sm mt-1 text-left">@Model.Result.SymptomText</div>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary border border-primary/20"><span class="material-symbols-outlined">smart_toy</span></div>
                                <div class="max-w-[85%]">
                                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Trợ lý MediConnect</span>
                                    <div class="bg-slate-100 p-4 rounded-xl rounded-tl-none text-sm mt-1">@Model.Result.AssistantReply</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="p-6 border-t border-slate-200 bg-slate-50">
                    <form id="chatForm" method="post" asp-page-handler="Chat" class="space-y-3">
                        <div class="flex flex-wrap gap-2">
                            <button type="button" class="symptom-tag px-3 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-600 hover:border-primary hover:bg-primary/5 hover:text-primary transition-all cursor-pointer" data-symptom="Đau đầu">Đau đầu</button>
                            <button type="button" class="symptom-tag px-3 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-600 hover:border-primary hover:bg-primary/5 hover:text-primary transition-all cursor-pointer" data-symptom="Đau người">Đau người</button>
                            <button type="button" class="symptom-tag px-3 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-600 hover:border-primary hover:bg-primary/5 hover:text-primary transition-all cursor-pointer" data-symptom="Mệt mỏi">Mệt mỏi</button>
                            <button type="button" class="symptom-tag px-3 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-600 hover:border-primary hover:bg-primary/5 hover:text-primary transition-all cursor-pointer" data-symptom="Sốt cao">Sốt cao</button>
                            <button type="button" class="symptom-tag px-3 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-600 hover:border-primary hover:bg-primary/5 hover:text-primary transition-all cursor-pointer" data-symptom="Ho khan">Ho khan</button>
                        </div>
                        <div class="flex items-center gap-3">
                            <textarea id="symptomInput" asp-for="SymptomText" rows="2" class="flex-1 bg-white border border-slate-200 rounded-xl px-4 py-3 text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="Nhập triệu chứng của bạn tại đây..."></textarea>
                            <button id="sendButton" type="submit" class="w-12 h-12 rounded-xl bg-primary text-white hover:bg-primary/90 transition-all"><span class="material-symbols-outlined">send</span></button>
                        </div>
                        <span id="chatError" asp-validation-for="SymptomText" class="text-red-500 text-sm"></span>
                    </form>
                </div>
            </div>

        </div>

        <aside class="space-y-6">
            <!-- Quick Actions -->
            <div class="bg-gradient-to-br from-primary/5 to-primary/10 p-5 rounded-xl border border-primary/20">
                <h3 class="font-bold text-slate-900 mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-xl">explore</span>
                    Khám phá thêm
                </h3>
                <div class="space-y-2">
                    <a asp-page="/Patient/DoctorSearch" class="block w-full bg-white hover:bg-slate-50 text-slate-700 py-2.5 px-4 rounded-lg text-sm font-semibold no-underline text-center transition-all border border-slate-200 hover:border-primary">
                        <span class="flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-base">search</span>
                            Tìm bác sĩ theo bộ lọc
                        </span>
                    </a>
                    <a asp-page="/Patient/Dashboard" class="block w-full bg-white hover:bg-slate-50 text-slate-700 py-2.5 px-4 rounded-lg text-sm font-semibold no-underline text-center transition-all border border-slate-200 hover:border-slate-300">
                        <span class="flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-base">dashboard</span>
                            Về Dashboard
                        </span>
                    </a>
                </div>
            </div>

            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-bold text-slate-900 flex items-center gap-2"><span class="material-symbols-outlined text-red-500 text-xl">emergency</span>Lịch tư vấn khẩn cấp</h3>
                    <span class="px-2 py-0.5 rounded-full bg-red-100 text-[10px] font-bold text-red-600">LIVE</span>
                </div>
                <div class="flex items-center gap-4 bg-red-50 p-3 rounded-lg border border-red-100">
                    <div class="flex-1"><div class="text-sm font-bold text-red-700">Còn 2 chỗ trống ưu tiên</div><p class="text-[11px] text-red-500">Trong khung giờ hành chính hôm nay</p></div>
                    <button class="bg-red-500 text-white text-[11px] font-bold px-3 py-1.5 rounded-md hover:bg-red-600 transition-colors">Yêu cầu</button>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-5 border-b border-slate-100">
                    <div class="flex items-center justify-between mb-2"><span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Đề xuất chuyên khoa</span><span class="material-symbols-outlined text-primary text-lg">respiratory_rate</span></div>
                    <h3 id="suggestedSpecialty" class="text-2xl font-black" data-specialty-name="@Model.Result?.SuggestedSpecialty">@Model.Result?.SuggestedSpecialty</h3>
                    <p class="text-xs text-slate-500 mt-1">Dựa trên triệu chứng của bạn</p>
                    <div class="mt-3" id="viewAllDoctorsContainer" style="display: none;">
                        <a id="viewAllDoctorsLink" href="#" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary/80 no-underline transition-colors">
                            <span class="material-symbols-outlined text-base">person_search</span>
                            Xem tất cả bác sĩ chuyên khoa này
                            <span class="material-symbols-outlined text-base">arrow_forward</span>
                        </a>
                    </div>
                </div>

                <div class="p-5 bg-slate-50/50">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <div class="text-xs font-bold text-slate-700">Lịch trống hôm nay</div>
                            <div class="text-[10px] text-slate-400">@DateTime.Now.ToString("dddd, dd 'Tháng' MM")</div>
                        </div>
                        <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-primary hover:bg-slate-50 transition-colors"><span class="material-symbols-outlined text-base">calendar_month</span></button>
                    </div>
                    <div class="grid grid-cols-4 gap-2 mb-5">
                        <button class="py-2 rounded-lg border border-slate-200 bg-white text-xs font-bold hover:border-primary hover:bg-primary/5 transition-all">14:00</button>
                        <button class="py-2 rounded-lg border border-slate-200 bg-white text-xs font-bold hover:border-primary hover:bg-primary/5 transition-all">14:30</button>
                        <button class="py-2 rounded-lg border border-primary bg-primary/5 text-primary text-xs font-bold">15:00</button>
                        <button class="py-2 rounded-lg border border-slate-200 bg-white text-xs font-bold hover:border-primary hover:bg-primary/5 transition-all">15:30</button>
                    </div>

                    <div class="bg-white rounded-xl border-2 border-primary overflow-hidden">
                        <div class="bg-primary px-3 py-1.5 flex items-center gap-2"><span class="material-symbols-outlined text-white text-sm">stars</span><span class="text-[10px] font-black text-white uppercase">Bác sĩ phù hợp nhất</span></div>
                        <div id="topDoctorCard" class="p-4">
                            @if (Model.Result?.SuggestedDoctors?.Count > 0)
                            {
                                var topDoctor = Model.Result.SuggestedDoctors[0];
                                <h4 class="font-bold">@topDoctor.FullName</h4>
                                <p class="text-xs text-primary font-semibold">@(topDoctor.DepartmentName ?? "Chưa cập nhật")</p>
                                <p class="text-xs text-slate-500 mt-1">⭐ @topDoctor.AverageRating.ToString("0.0") • @topDoctor.YearsOfExperience năm KN</p>
                                <div class="grid grid-cols-2 gap-3 mt-4">
                                    <a asp-page="/Patient/DoctorProfile" asp-route-doctorProfileId="@topDoctor.DoctorProfileId" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-lg text-xs font-bold no-underline text-center transition-all">Xem hồ sơ</a>
                                    <a asp-page="/Patient/DoctorProfile" asp-route-doctorProfileId="@topDoctor.DoctorProfileId" class="w-full bg-primary hover:bg-primary/90 text-white py-2.5 rounded-lg text-xs font-bold no-underline text-center transition-all">Đặt lịch ngay</a>
                                </div>
                            }
                            else
                            {
                                <p class="text-sm text-slate-500">Chưa có bác sĩ gợi ý. Hãy mô tả triệu chứng để nhận gợi ý phù hợp!</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="p-4 rounded-xl bg-slate-100 border border-slate-200 text-[11px] text-slate-500">
                <strong>Thông báo miễn trừ trách nhiệm y tế:</strong> Công cụ chỉ mang tính tham khảo và không thay thế chẩn đoán chuyên môn.
            </div>
        </aside>
    </div>
</main>

<script>
    (() => {
        const form = document.getElementById("chatForm");
        const input = document.getElementById("symptomInput");
        const sendButton = document.getElementById("sendButton");
        const chatThread = document.getElementById("chatThread");
        const chatContainer = document.getElementById("chatContainer");
        const chatError = document.getElementById("chatError");
        const specialtyEl = document.getElementById("suggestedSpecialty");
        const riskScoreText = document.getElementById("riskScoreText");
        const riskScoreBar = document.getElementById("riskScoreBar");
        const topDoctorCard = document.getElementById("topDoctorCard");
        const viewAllDoctorsContainer = document.getElementById("viewAllDoctorsContainer");
        const viewAllDoctorsLink = document.getElementById("viewAllDoctorsLink");
        const symptomTags = document.querySelectorAll(".symptom-tag");

        if (!form || !input || !sendButton || !chatThread) return;

        // Clickable symptom tags
        symptomTags.forEach(tag => {
            tag.addEventListener("click", (e) => {
                e.preventDefault();
                const symptom = tag.getAttribute("data-symptom");
                const currentValue = input.value.trim();
                if (currentValue) {
                    input.value = currentValue + ", " + symptom;
                } else {
                    input.value = symptom;
                }
                input.focus();
            });
        });

        const escapeHtml = (value) => {
            return (value || "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll("\"", "&quot;")
                .replaceAll("'", "&#39;");
        };

        const appendUserMessage = (text) => {
            chatThread.insertAdjacentHTML("beforeend", `
                <div class="flex items-start gap-4 flex-row-reverse">
                    <div class="w-10 h-10 rounded-full bg-slate-200"></div>
                    <div class="max-w-[85%] text-right">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Bạn</span>
                        <div class="bg-primary text-white p-4 rounded-xl rounded-tr-none text-sm mt-1 text-left">${escapeHtml(text)}</div>
                    </div>
                </div>
            `);
        };

        const appendAssistantMessage = (text) => {
            chatThread.insertAdjacentHTML("beforeend", `
                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary border border-primary/20"><span class="material-symbols-outlined">smart_toy</span></div>
                    <div class="max-w-[85%]">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Trợ lý MediConnect</span>
                        <div class="bg-slate-100 p-4 rounded-xl rounded-tl-none text-sm mt-1 whitespace-pre-line">${escapeHtml(text)}</div>
                    </div>
                </div>
            `);
        };

        const setLoading = (isLoading) => {
            sendButton.disabled = isLoading;
            sendButton.classList.toggle("opacity-60", isLoading);
        };

        const smoothScroll = () => {
            if (chatContainer) {
                chatContainer.scrollTo({
                    top: chatContainer.scrollHeight,
                    behavior: 'smooth'
                });
            }
        };

        // Map specialty names to IDs (you may need to adjust these based on your database)
        const specialtyMap = {
            "Tim mạch": 1,
            "Nội khoa": 2,
            "Ngoại khoa": 3,
            "Nhi khoa": 4,
            "Sản phụ khoa": 5,
            "Da liễu": 6,
            "Mắt": 7,
            "Tai Mũi Họng": 8,
            "Thần kinh": 9,
            "Tổng quát": 10
        };

        const updateViewAllDoctorsLink = (specialtyName) => {
            if (!specialtyName || specialtyName === "Tổng quát" || !viewAllDoctorsContainer || !viewAllDoctorsLink) {
                if (viewAllDoctorsContainer) viewAllDoctorsContainer.style.display = "none";
                return;
            }

            const specialtyId = specialtyMap[specialtyName];
            if (specialtyId) {
                viewAllDoctorsLink.href = `/Patient/DoctorSearch?SpecialtyId=${specialtyId}`;
                viewAllDoctorsContainer.style.display = "block";
            } else {
                // Fallback: search by specialty name
                viewAllDoctorsLink.href = `/Patient/DoctorSearch?SearchTerm=${encodeURIComponent(specialtyName)}`;
                viewAllDoctorsContainer.style.display = "block";
            }
        };

        input.addEventListener("keydown", (event) => {
            if (event.key === "Enter" && !event.shiftKey) {
                event.preventDefault();
                form.requestSubmit();
            }
        });

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            chatError.textContent = "";

            const text = input.value.trim();
            if (!text) {
                chatError.textContent = "Vui lòng nhập triệu chứng.";
                return;
            }

            const payload = new FormData(form);

            appendUserMessage(text);
            input.value = "";
            input.focus();
            appendAssistantMessage("Mình đang phân tích triệu chứng của bạn...");
            const loadingNode = chatThread.lastElementChild;
            smoothScroll();

            setLoading(true);
            try {
                const response = await fetch(`${window.location.pathname}?handler=Chat`, {
                    method: "POST",
                    body: payload
                });

                const data = await response.json();
                loadingNode?.remove();

                if (!data.success) {
                    chatError.textContent = data.error || "Không thể phân tích triệu chứng, vui lòng thử lại.";
                    return;
                }

                appendAssistantMessage(data.assistantReply || "Mình đã nhận được thông tin của bạn.");
                const specialty = data.suggestedSpecialty || "Tổng quát";
                specialtyEl.textContent = specialty;
                specialtyEl.setAttribute("data-specialty-name", specialty);
                updateViewAllDoctorsLink(specialty);

                const scoreValue = Number(data.riskScore);
                const score = Number.isFinite(scoreValue) ? Math.max(0, Math.min(100, scoreValue)) : 20;
                if (riskScoreText) riskScoreText.textContent = `${score}%`;
                if (riskScoreBar) riskScoreBar.style.width = `${score}%`;

                if (Array.isArray(data.suggestedDoctors) && data.suggestedDoctors.length > 0) {
                    const topDoctor = data.suggestedDoctors[0];
                    topDoctorCard.innerHTML = `
                        <h4 class="font-bold">${escapeHtml(topDoctor.fullName || "Bác sĩ")}</h4>
                        <p class="text-xs text-primary font-semibold">${escapeHtml(topDoctor.departmentName || "Chưa cập nhật")}</p>
                        <p class="text-xs text-slate-500 mt-1">⭐ ${topDoctor.averageRating ? topDoctor.averageRating.toFixed(1) : '0.0'} • ${topDoctor.yearsOfExperience || 0} năm KN</p>
                        <div class="grid grid-cols-2 gap-3 mt-4">
                            <a href="/Patient/DoctorProfile?doctorProfileId=${encodeURIComponent(topDoctor.doctorProfileId)}" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-lg text-xs font-bold no-underline text-center transition-all">Xem hồ sơ</a>
                            <a href="/Patient/DoctorProfile?doctorProfileId=${encodeURIComponent(topDoctor.doctorProfileId)}" class="w-full bg-primary hover:bg-primary/90 text-white py-2.5 rounded-lg text-xs font-bold no-underline text-center transition-all">Đặt lịch ngay</a>
                        </div>
                    `;
                } else {
                    topDoctorCard.innerHTML = `<p class="text-sm text-slate-500">Chưa có bác sĩ gợi ý. Hãy mô tả triệu chứng để nhận gợi ý phù hợp!</p>`;
                }
            } catch (error) {
                loadingNode?.remove();
                chatError.textContent = "Kết nối tạm thời gián đoạn. Bạn thử gửi lại sau vài giây nhé.";
            } finally {
                setLoading(false);
                smoothScroll();
            }
        });

        // Initialize view all doctors link on page load
        const initialSpecialty = specialtyEl.getAttribute("data-specialty-name");
        if (initialSpecialty) {
            updateViewAllDoctorsLink(initialSpecialty);
        }
    })();
</script>
