@page
@{
    ViewData["Title"] = "Quy Trình Khám Bệnh";
}

<!-- Hero Section -->
<div class="bg-gradient-to-br from-primary via-[#137fec] to-blue-700 text-white">
    <div class="max-w-[1280px] mx-auto px-6 py-12 lg:py-16">
        <div class="text-center">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-4">Quy Trình Khám Bệnh</h1>
            <p class="text-lg text-blue-100 max-w-2xl mx-auto">
                Tìm hiểu quy trình khám bệnh tại MediConnect để chuẩn bị tốt nhất cho buổi khám của bạn
            </p>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="max-w-[1280px] mx-auto px-6 py-12">
    
    <!-- Timeline Container -->
    <div class="relative">
        <!-- Vertical Line -->
        <div class="absolute left-6 lg:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary via-blue-400 to-emerald-500 transform lg:-translate-x-1/2 hidden sm:block"></div>

        <!-- Step 1: Đăng ký khám -->
        <div class="relative flex flex-col lg:flex-row items-start lg:items-center gap-6 mb-12">
            <!-- Timeline Dot -->
            <div class="absolute left-6 lg:left-1/2 w-12 h-12 bg-primary rounded-full flex items-center justify-center transform -translate-x-1/2 z-10 shadow-lg shadow-blue-500/30">
                <span class="material-symbols-outlined text-white text-2xl">how_to_reg</span>
            </div>
            
            <!-- Content Card - Left Side -->
            <div class="lg:w-1/2 lg:pr-16 pl-20 lg:pl-0 lg:text-right">
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm card-hover-effect">
                    <div class="flex items-center gap-3 lg:justify-end mb-4">
                        <span class="inline-flex items-center justify-center w-8 h-8 bg-blue-100 text-primary rounded-full font-bold text-sm">1</span>
                        <h3 class="text-xl font-bold text-[#0d141b]">Đăng Ký Khám Bệnh</h3>
                    </div>
                    <p class="text-slate-600 mb-4">Bệnh nhân đăng ký khám trực tuyến hoặc tại quầy tiếp nhận của bệnh viện.</p>
                    <div class="flex flex-wrap gap-2 lg:justify-end">
                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-blue-50 text-primary rounded-full text-sm font-medium">
                            <span class="material-symbols-outlined text-base">computer</span>
                            Online
                        </span>
                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-full text-sm font-medium">
                            <span class="material-symbols-outlined text-base">storefront</span>
                            Tại quầy
                        </span>
                    </div>
                </div>
            </div>
            
            <!-- Empty Right Side -->
            <div class="hidden lg:block lg:w-1/2"></div>
        </div>

        <!-- Step 2: Khám lâm sàng ban đầu -->
        <div class="relative flex flex-col lg:flex-row items-start lg:items-center gap-6 mb-12">
            <!-- Timeline Dot -->
            <div class="absolute left-6 lg:left-1/2 w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center transform -translate-x-1/2 z-10 shadow-lg shadow-blue-500/30">
                <span class="material-symbols-outlined text-white text-2xl">stethoscope</span>
            </div>
            
            <!-- Empty Left Side -->
            <div class="hidden lg:block lg:w-1/2"></div>
            
            <!-- Content Card - Right Side -->
            <div class="lg:w-1/2 lg:pl-16 pl-20">
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm card-hover-effect">
                    <div class="flex items-center gap-3 mb-4">
                        <span class="inline-flex items-center justify-center w-8 h-8 bg-blue-100 text-blue-600 rounded-full font-bold text-sm">2</span>
                        <h3 class="text-xl font-bold text-[#0d141b]">Khám Lâm Sàng Ban Đầu</h3>
                    </div>
                    <p class="text-slate-600 mb-4">Bác sĩ tiến hành hỏi bệnh và khám tổng quát để đưa ra chẩn đoán sơ bộ.</p>
                    
                    <div class="space-y-3">
                        <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-xl">
                            <span class="material-symbols-outlined text-blue-500">chat</span>
                            <div>
                                <p class="font-semibold text-[#0d141b] text-sm">Hỏi bệnh</p>
                                <p class="text-slate-500 text-sm">Triệu chứng, tiền sử bệnh, dị ứng thuốc...</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-xl">
                            <span class="material-symbols-outlined text-emerald-500">vital_signs</span>
                            <div>
                                <p class="font-semibold text-[#0d141b] text-sm">Khám tổng quát</p>
                                <p class="text-slate-500 text-sm">Đo huyết áp, nhịp tim, nhiệt độ cơ thể...</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-xl">
                            <span class="material-symbols-outlined text-amber-500">diagnosis</span>
                            <div>
                                <p class="font-semibold text-[#0d141b] text-sm">Chẩn đoán sơ bộ</p>
                                <p class="text-slate-500 text-sm">Đánh giá ban đầu về tình trạng sức khỏe</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3: Chỉ định cận lâm sàng -->
        <div class="relative flex flex-col lg:flex-row items-start lg:items-center gap-6 mb-12">
            <!-- Timeline Dot -->
            <div class="absolute left-6 lg:left-1/2 w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center transform -translate-x-1/2 z-10 shadow-lg shadow-purple-500/30">
                <span class="material-symbols-outlined text-white text-2xl">biotech</span>
            </div>
            
            <!-- Content Card - Left Side -->
            <div class="lg:w-1/2 lg:pr-16 pl-20 lg:pl-0 lg:text-right">
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm card-hover-effect">
                    <div class="flex items-center gap-3 lg:justify-end mb-4">
                        <span class="inline-flex items-center justify-center w-8 h-8 bg-purple-100 text-purple-600 rounded-full font-bold text-sm">3</span>
                        <h3 class="text-xl font-bold text-[#0d141b]">Chỉ Định Cận Lâm Sàng</h3>
                    </div>
                    <p class="text-slate-600 mb-4">Bác sĩ có thể yêu cầu các xét nghiệm và chẩn đoán hình ảnh để xác định chính xác tình trạng bệnh.</p>
                    
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-amber-50 text-amber-700 rounded-full text-sm font-medium mb-4">
                        <span class="material-symbols-outlined text-base">info</span>
                        Chỉ thực hiện khi cần thiết
                    </div>
                    
                    <div class="grid grid-cols-2 gap-3">
                        <div class="flex items-center gap-2 p-3 bg-purple-50 rounded-xl lg:justify-end">
                            <span class="material-symbols-outlined text-purple-500">water_drop</span>
                            <span class="text-sm font-medium text-purple-700">Xét nghiệm máu</span>
                        </div>
                        <div class="flex items-center gap-2 p-3 bg-purple-50 rounded-xl lg:justify-end">
                            <span class="material-symbols-outlined text-purple-500">science</span>
                            <span class="text-sm font-medium text-purple-700">Xét nghiệm nước tiểu</span>
                        </div>
                        <div class="flex items-center gap-2 p-3 bg-purple-50 rounded-xl lg:justify-end">
                            <span class="material-symbols-outlined text-purple-500">radiology</span>
                            <span class="text-sm font-medium text-purple-700">Chụp X-quang</span>
                        </div>
                        <div class="flex items-center gap-2 p-3 bg-purple-50 rounded-xl lg:justify-end">
                            <span class="material-symbols-outlined text-purple-500">mri</span>
                            <span class="text-sm font-medium text-purple-700">CT / MRI</span>
                        </div>
                        <div class="flex items-center gap-2 p-3 bg-purple-50 rounded-xl lg:justify-end col-span-2">
                            <span class="material-symbols-outlined text-purple-500">ecg</span>
                            <span class="text-sm font-medium text-purple-700">Siêu âm</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Empty Right Side -->
            <div class="hidden lg:block lg:w-1/2"></div>
        </div>

        <!-- Step 4: Nhận kết quả & chẩn đoán -->
        <div class="relative flex flex-col lg:flex-row items-start lg:items-center gap-6 mb-12">
            <!-- Timeline Dot -->
            <div class="absolute left-6 lg:left-1/2 w-12 h-12 bg-emerald-500 rounded-full flex items-center justify-center transform -translate-x-1/2 z-10 shadow-lg shadow-emerald-500/30">
                <span class="material-symbols-outlined text-white text-2xl">assignment_turned_in</span>
            </div>
            
            <!-- Empty Left Side -->
            <div class="hidden lg:block lg:w-1/2"></div>
            
            <!-- Content Card - Right Side -->
            <div class="lg:w-1/2 lg:pl-16 pl-20">
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm card-hover-effect">
                    <div class="flex items-center gap-3 mb-4">
                        <span class="inline-flex items-center justify-center w-8 h-8 bg-emerald-100 text-emerald-600 rounded-full font-bold text-sm">4</span>
                        <h3 class="text-xl font-bold text-[#0d141b]">Nhận Kết Quả & Chẩn Đoán</h3>
                    </div>
                    <p class="text-slate-600 mb-4">Bệnh nhân quay lại gặp bác sĩ để nhận kết quả xét nghiệm và chẩn đoán cuối cùng.</p>
                    
                    <div class="space-y-3">
                        <div class="flex items-center gap-3 p-3 bg-emerald-50 rounded-xl">
                            <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center">
                                <span class="material-symbols-outlined text-white text-lg">schedule</span>
                            </div>
                            <div>
                                <p class="font-semibold text-[#0d141b] text-sm">Tái khám theo hẹn</p>
                                <p class="text-slate-500 text-xs">Quay lại gặp bác sĩ theo lịch hẹn</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 bg-emerald-50 rounded-xl">
                            <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center">
                                <span class="material-symbols-outlined text-white text-lg">lab_profile</span>
                            </div>
                            <div>
                                <p class="font-semibold text-[#0d141b] text-sm">Đọc kết quả xét nghiệm</p>
                                <p class="text-slate-500 text-xs">Bác sĩ phân tích và giải thích kết quả</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 bg-emerald-50 rounded-xl">
                            <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center">
                                <span class="material-symbols-outlined text-white text-lg">verified</span>
                            </div>
                            <div>
                                <p class="font-semibold text-[#0d141b] text-sm">Chẩn đoán cuối cùng</p>
                                <p class="text-slate-500 text-xs">Xác định bệnh và kế hoạch điều trị</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 5: Kê đơn & Điều trị -->
        <div class="relative flex flex-col lg:flex-row items-start lg:items-center gap-6">
            <!-- Timeline Dot -->
            <div class="absolute left-6 lg:left-1/2 w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-full flex items-center justify-center transform -translate-x-1/2 z-10 shadow-lg shadow-emerald-500/30">
                <span class="material-symbols-outlined text-white text-2xl">medication</span>
            </div>
            
            <!-- Content Card - Left Side -->
            <div class="lg:w-1/2 lg:pr-16 pl-20 lg:pl-0 lg:text-right">
                <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-2xl border border-emerald-200 p-6 shadow-sm card-hover-effect">
                    <div class="flex items-center gap-3 lg:justify-end mb-4">
                        <span class="inline-flex items-center justify-center w-8 h-8 bg-emerald-500 text-white rounded-full font-bold text-sm">5</span>
                        <h3 class="text-xl font-bold text-[#0d141b]">Kê Đơn & Hướng Dẫn Điều Trị</h3>
                    </div>
                    <p class="text-slate-600 mb-4">Bác sĩ kê đơn thuốc và hướng dẫn chi tiết phương pháp điều trị phù hợp.</p>
                    
                    <div class="flex flex-wrap gap-2 lg:justify-end">
                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-white text-emerald-700 rounded-full text-sm font-medium shadow-sm">
                            <span class="material-symbols-outlined text-base">prescription</span>
                            Đơn thuốc
                        </span>
                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-white text-emerald-700 rounded-full text-sm font-medium shadow-sm">
                            <span class="material-symbols-outlined text-base">event_repeat</span>
                            Lịch tái khám
                        </span>
                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-white text-emerald-700 rounded-full text-sm font-medium shadow-sm">
                            <span class="material-symbols-outlined text-base">tips_and_updates</span>
                            Lời khuyên
                        </span>
                    </div>
                </div>
            </div>
            
            <!-- Empty Right Side -->
            <div class="hidden lg:block lg:w-1/2"></div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-16 bg-gradient-to-r from-primary to-blue-600 rounded-2xl p-8 lg:p-12 text-center text-white">
        <h2 class="text-2xl lg:text-3xl font-extrabold mb-4">Sẵn sàng đặt lịch khám?</h2>
        <p class="text-blue-100 mb-6 max-w-xl mx-auto">Đặt lịch khám với bác sĩ chuyên khoa ngay hôm nay để được chăm sóc sức khỏe tốt nhất</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a asp-page="/Doctors/Index" class="inline-flex items-center justify-center gap-2 bg-white text-primary px-6 py-3 rounded-xl font-bold hover:bg-blue-50 transition-colors">
                <span class="material-symbols-outlined">search</span>
                Tìm bác sĩ
            </a>
            <a asp-page="/Patient/Dashboard" class="inline-flex items-center justify-center gap-2 bg-blue-500 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-400 transition-colors border border-blue-400">
                <span class="material-symbols-outlined">dashboard</span>
                Xem Dashboard
            </a>
        </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-16">
        <h2 class="text-2xl font-extrabold text-[#0d141b] text-center mb-8">Câu Hỏi Thường Gặp</h2>
        <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white rounded-xl border border-slate-200 p-6">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary">help</span>
                    <div>
                        <h4 class="font-bold text-[#0d141b] mb-2">Tôi cần chuẩn bị gì trước khi khám?</h4>
                        <p class="text-slate-600 text-sm">Mang theo CMND/CCCD, thẻ BHYT (nếu có), các kết quả xét nghiệm cũ, và danh sách thuốc đang sử dụng.</p>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-6">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary">help</span>
                    <div>
                        <h4 class="font-bold text-[#0d141b] mb-2">Kết quả xét nghiệm có trong bao lâu?</h4>
                        <p class="text-slate-600 text-sm">Thông thường từ 30 phút đến 2 giờ với xét nghiệm cơ bản. Xét nghiệm phức tạp có thể mất 1-3 ngày.</p>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-6">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary">help</span>
                    <div>
                        <h4 class="font-bold text-[#0d141b] mb-2">Có thể xem kết quả online không?</h4>
                        <p class="text-slate-600 text-sm">Có, bạn có thể xem kết quả xét nghiệm và hồ sơ y tế trực tuyến qua hệ thống MediConnect.</p>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-6">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary">help</span>
                    <div>
                        <h4 class="font-bold text-[#0d141b] mb-2">Tôi có thể đổi bác sĩ được không?</h4>
                        <p class="text-slate-600 text-sm">Được, bạn hoàn toàn có thể đổi bác sĩ khám nếu cần. Vui lòng liên hệ bộ phận tiếp nhận hoặc đặt lịch mới.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
