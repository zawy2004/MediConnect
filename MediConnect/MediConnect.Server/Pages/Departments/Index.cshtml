@page
@model MediConnect.Server.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Khoa / Phòng ban";
}

<h2 class="page-header"><i class="bi bi-building"></i> Danh sách khoa</h2>

<div class="row">
    @foreach (var dept in Model.Departments)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card card-hover border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5><i class="bi bi-building text-primary"></i> @dept.DepartmentName</h5>
                    <p class="text-muted">@dept.Description</p>
                    @if (!string.IsNullOrEmpty(dept.Location))
                    {
                        <p class="mb-0">
                            <i class="bi bi-geo-alt text-danger"></i>
                            <small class="text-muted">@dept.Location</small>
                        </p>
                    }
                </div>
            </div>
        </div>
    }
</div>
