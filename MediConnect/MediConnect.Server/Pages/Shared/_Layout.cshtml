<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediConnect</title>

    <!-- Google Fonts: Manrope -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @if (ViewData["HideLayout"] as bool? != true)
    {
        <!-- Navigation -->
        @if (ViewData["UseSidebar"] as bool? == true)
        {
            @await Html.PartialAsync("_SidebarLayout")
        }
        else
        {
            <nav class="navbar navbar-expand-lg mc-navbar sticky-top">
                <div class="container">
                    <a class="navbar-brand" asp-page="/Index">
                        <i class="bi bi-shield-plus"></i> MediConnect
                    </a>
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Doctors/Index">Tìm bác sĩ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Specialties/Index">Chuyên khoa</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Appointments/Index">Lịch hẹn của tôi</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Patient/HealthRecords">Hồ sơ sức khỏe</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item me-2">
                                <a class="nav-link" asp-page="/Auth/Login">
                                    <i class="bi bi-bell"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-login" asp-page="/Auth/Login">Đăng nhập</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="container py-4">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="mc-footer">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <span class="fw-bold text-dark"><i class="bi bi-shield-plus"></i> MediConnect</span>
                        </div>
                        <div class="col-md-4 text-center">
                            <span><i class="bi bi-shield-check"></i> TUÂN THỦ HIPAA</span>
                            <span class="ms-3"><i class="bi bi-lock"></i> MÃ HÓA 256-BIT</span>
                        </div>
                        <div class="col-md-4 text-end">
                            &copy; @DateTime.Now.Year MediConnect Healthcare Systems.
                        </div>
                    </div>
                </div>
            </footer>
        }
    }
    else
    {
        @RenderBody()
    }

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
