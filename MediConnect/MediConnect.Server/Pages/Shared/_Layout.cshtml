<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediConnect</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">
                <i class="bi bi-hospital"></i> MediConnect
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            <i class="bi bi-house"></i> Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Doctors/Index">
                            <i class="bi bi-person-badge"></i> Bác sĩ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Appointments/Index">
                            <i class="bi bi-calendar-check"></i> Lịch hẹn
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Specialties/Index">
                            <i class="bi bi-heart-pulse"></i> Chuyên khoa
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Departments/Index">
                            <i class="bi bi-building"></i> Khoa
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Auth/Login">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Auth/Register">
                            <i class="bi bi-person-plus"></i> Đăng ký
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light py-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="bi bi-hospital"></i> MediConnect</h5>
                    <p class="text-secondary">Nền tảng đặt lịch khám bệnh trực tuyến.</p>
                </div>
                <div class="col-md-4">
                    <h5>Liên kết</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-secondary text-decoration-none">Về chúng tôi</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Chính sách bảo mật</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Liên hệ</h5>
                    <p class="text-secondary mb-1"><i class="bi bi-envelope"></i> support@mediconnect.vn</p>
                    <p class="text-secondary mb-1"><i class="bi bi-telephone"></i> 1900-xxxx</p>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center text-secondary mb-0">&copy; 2026 MediConnect. All rights reserved.</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
