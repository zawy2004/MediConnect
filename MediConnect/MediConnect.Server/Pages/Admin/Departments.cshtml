@page
@model MediConnect.Server.Pages.Admin.DepartmentsModel
@{
    ViewData["Title"] = "Quản lý chuyên khoa";
    ViewData["UseSidebar"] = true;
    ViewData["SidebarRole"] = "admin";
    ViewData["ActiveSidebar"] = "departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Quản lý Chuyên khoa</h4>
        <p class="text-muted mb-0">Cấu hình chuyên khoa và phân bổ bác sĩ</p>
    </div>
    <button type="button" class="btn btn-mc-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-lg me-1"></i>Thêm chuyên khoa mới
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- AI Insight Banner -->
<div class="rounded-4 p-4 mb-4" style="background:#f5f3ff;border:1px solid #e9e5ff">
    <div class="d-flex align-items-start gap-3">
        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:40px;height:40px;background:#8b5cf6;flex-shrink:0">
            <i class="bi bi-stars text-white"></i>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill px-2 py-1" style="background:#8b5cf6;color:white;font-size:.7rem">AI Insight</span>
                <span class="fw-bold" style="font-size:.9rem">Gợi ý phân bổ nguồn lực</span>
            </div>
            <p class="text-muted mb-0" style="font-size:.85rem">
                Chuyên khoa Nhi đang có nhu cầu cao (dự kiến tăng 25% trong tháng tới). Đề xuất bổ sung thêm 2 bác sĩ chuyên khoa Nhi để đáp ứng nhu cầu.
            </p>
        </div>
    </div>
</div>

<!-- Search -->
<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <div class="position-relative">
            <i class="bi bi-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:var(--mc-text-muted)"></i>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="mc-form-control" placeholder="Tìm kiếm chuyên khoa..." style="padding-left:36px" />
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-mc-primary"><i class="bi bi-search me-1"></i>Tìm</button>
    </div>
</form>

<div class="row g-4">
    <!-- Specialty Table -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Danh sách Chuyên khoa</h6>
                    <span class="text-muted" style="font-size:.85rem">@Model.Specialties.Count chuyên khoa</span>
                </div>
                @if (Model.Specialties.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <thead>
                                <tr style="font-size:.8rem;color:var(--mc-text-muted)">
                                    <th>Tên chuyên khoa</th>
                                    <th>Mô tả</th>
                                    <th>Bác sĩ</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var colors = new[] { "#137fec", "#f59e0b", "#8b5cf6", "#22c55e", "#ef4444", "#06b6d4" }; var idx = 0; }
                                @foreach (var item in Model.Specialties)
                                {
                                    var iconColor = colors[idx % colors.Length];
                                    idx++;
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-2 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:@(iconColor)15">
                                                    <i class="bi bi-heart-pulse" style="color:@iconColor"></i>
                                                </div>
                                                <span class="fw-semibold" style="font-size:.9rem">@item.Specialty.SpecialtyName</span>
                                            </div>
                                        </td>
                                        <td class="text-muted" style="font-size:.85rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                            @(item.Specialty.Description ?? "—")
                                        </td>
                                        <td>
                                            <span class="fw-semibold" style="font-size:.9rem">@item.DoctorCount</span>
                                            <span class="text-muted" style="font-size:.75rem">bác sĩ</span>
                                        </td>
                                        <td>
                                            @if (item.Specialty.IsActive)
                                            {
                                                <span class="badge rounded-pill px-2 py-1" style="background:#e6f9ee;color:#22c55e;font-size:.75rem">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill px-2 py-1" style="background:#f1f5f9;color:#94a3b8;border:1px solid #e2e8f0;font-size:.75rem">Tạm dừng</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <form method="post" class="d-inline">
                                                <input type="hidden" name="specialtyId" value="@item.Specialty.SpecialtyId" />
                                                <button type="submit" asp-page-handler="Toggle" class="btn btn-sm rounded-2" style="background:var(--mc-bg);border:none" title="@(item.Specialty.IsActive ? "Tạm dừng" : "Kích hoạt")">
                                                    <i class="bi @(item.Specialty.IsActive ? "bi-pause-circle" : "bi-play-circle")" style="color:@(item.Specialty.IsActive ? "#f59e0b" : "#22c55e")"></i>
                                                </button>
                                                <button type="submit" asp-page-handler="Delete" class="btn btn-sm rounded-2 ms-1" style="background:var(--mc-bg);border:none" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa chuyên khoa này?')">
                                                    <i class="bi bi-trash" style="color:#ef4444"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-building" style="font-size:2rem"></i>
                        <p class="mt-2 mb-0">Chưa có chuyên khoa nào</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Department List -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Danh sách Khoa</h6>
                @if (Model.AllDepartments.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var dept in Model.AllDepartments)
                        {
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background:var(--mc-bg)">
                                <div>
                                    <div class="fw-semibold" style="font-size:.9rem">@dept.DepartmentName</div>
                                    @if (!string.IsNullOrEmpty(dept.Location))
                                    {
                                        <div class="text-muted" style="font-size:.75rem"><i class="bi bi-geo-alt me-1"></i>@dept.Location</div>
                                    }
                                </div>
                                @if (dept.IsActive)
                                {
                                    <span class="badge rounded-pill" style="background:#e6f9ee;color:#22c55e;font-size:.7rem">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill" style="background:#f1f5f9;color:#94a3b8;font-size:.7rem">Tạm dừng</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center mb-0" style="font-size:.85rem">Chưa có khoa nào</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add Specialty Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0">
            <form method="post" asp-page-handler="Add">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Thêm chuyên khoa mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium" style="font-size:.85rem">Tên chuyên khoa</label>
                        <input type="text" class="mc-form-control" name="NewSpecialtyName" required placeholder="Nhập tên chuyên khoa..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium" style="font-size:.85rem">Mô tả</label>
                        <textarea class="mc-form-control" name="NewDescription" rows="3" placeholder="Mô tả ngắn gọn..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-mc-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-mc-primary"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>
