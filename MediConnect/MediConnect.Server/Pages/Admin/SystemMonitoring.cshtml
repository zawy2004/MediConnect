@page
@model MediConnect.Server.Pages.Admin.SystemMonitoringModel
@{
    ViewData["Title"] = "Giám sát hệ thống";
    ViewData["HideLayout"] = true;
}

<div class="min-h-screen bg-[#f8fafc] flex">
    @await Html.PartialAsync("_AdminSidebar", "monitoring")
    <main class="flex-1 overflow-y-auto">
        <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between">
            <h1 class="text-3xl font-black">Giám sát & Bảo trì MediAdmin AI</h1>
            <a asp-page="/Admin/Dashboard" class="text-slate-500 no-underline">Quay lại dashboard</a>
        </header>

        <div class="p-8 space-y-6">
            <div class="bg-violet-50 border border-violet-200 rounded-2xl p-4">
                <p class="font-semibold text-violet-700">AI Insight Analysis</p>
                <p class="text-sm text-slate-600 mt-1">@Model.Data.PredictedLoadMessage</p>
            </div>

            <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white border rounded-2xl p-4"><p class="text-xs text-slate-500">Lỗi</p><p class="text-2xl font-black mt-2">@Model.Data.ErrorCount</p></div>
                <div class="bg-white border rounded-2xl p-4"><p class="text-xs text-slate-500">Cảnh báo</p><p class="text-2xl font-black mt-2">@Model.Data.WarningCount</p></div>
                <div class="bg-white border rounded-2xl p-4"><p class="text-xs text-slate-500">Thông tin</p><p class="text-2xl font-black mt-2">@Model.Data.InfoCount</p></div>
                <div class="bg-white border rounded-2xl p-4"><p class="text-xs text-slate-500">Backup progress</p><p class="text-2xl font-black mt-2">@Model.Data.BackupProgressPercent%</p></div>
            </section>

            <section class="bg-white border rounded-2xl overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                    <h2 class="text-lg font-bold">Nhật ký Hoạt động Thời gian thực</h2>
                    <input class="rounded-xl border-slate-200" placeholder="Tìm kiếm logs..." />
                </div>
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 text-slate-500">
                        <tr>
                            <th class="text-left px-4 py-3">Thời gian</th>
                            <th class="text-left px-4 py-3">Cấp độ</th>
                            <th class="text-left px-4 py-3">Hành động</th>
                            <th class="text-left px-4 py-3">Mô tả</th>
                            <th class="text-left px-4 py-3">Người dùng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Data.Logs)
                        {
                            <tr class="border-t border-slate-100">
                                <td class="px-4 py-3">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="px-4 py-3">@log.Severity</td>
                                <td class="px-4 py-3">@log.Action</td>
                                <td class="px-4 py-3">@log.Description</td>
                                <td class="px-4 py-3">@log.Username</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white border rounded-2xl p-5">
                    <h3 class="font-bold text-lg">Sao lưu nhanh (UC-32)</h3>
                    <div class="w-full h-2 bg-slate-100 rounded-full mt-4"><div class="h-2 bg-primary rounded-full" style="width:@Model.Data.BackupProgressPercent%"></div></div>
                    <button class="w-full mt-5 px-4 py-2 bg-primary text-white rounded-xl">Sao lưu toàn bộ ngay bây giờ</button>
                </div>
                <div class="bg-white border rounded-2xl p-5">
                    <h3 class="font-bold text-lg">Dự báo Tải trọng AI</h3>
                    <div class="h-28 border border-slate-100 rounded-xl bg-slate-50 mt-3"></div>
                    <p class="text-sm text-amber-600 mt-3">Dự báo hệ thống quá tải vào 09:00 AM ngày mai.</p>
                </div>
            </section>
        </div>
    </main>
</div>
