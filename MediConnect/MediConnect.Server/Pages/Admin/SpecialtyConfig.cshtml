@page
@model MediConnect.Server.Pages.Admin.SpecialtyConfigModel
@{
    ViewData["Title"] = "Cấu hình chuyên khoa";
    ViewData["HideLayout"] = true;
}

<div class="min-h-screen bg-slate-900/50 flex items-center justify-center p-6">
    <div class="w-full max-w-3xl bg-white rounded-3xl shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-black">Cấu hình Chuyên khoa</h1>
                <p class="text-xs text-slate-500">Mã quy trình: UC-13</p>
            </div>
            <a asp-page="/Admin/SpecialtyManagement" class="text-slate-400 no-underline">✕</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="mx-6 mt-4 bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 text-sm">@Model.StatusMessage</div>
        }

        <form method="post" asp-page-handler="Save" class="p-6 space-y-5">
            <input type="hidden" asp-for="SpecialtyId" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="text-sm text-slate-600">Tên chuyên khoa</label>
                    <input asp-for="SpecialtyName" class="mt-1 w-full rounded-xl border-slate-200" />
                </div>
                <div>
                    <label class="text-sm text-slate-600">Icon minh họa</label>
                    <input asp-for="IconUrl" class="mt-1 w-full rounded-xl border-slate-200" />
                </div>
            </div>

            <div>
                <label class="text-sm text-slate-600">Mô tả ngắn</label>
                <textarea asp-for="Description" rows="3" class="mt-1 w-full rounded-xl border-slate-200"></textarea>
            </div>

            <div>
                <h2 class="text-lg font-bold mb-2">Gán bác sĩ phụ trách</h2>
                <div class="max-h-[280px] overflow-auto border rounded-xl p-3 space-y-2">
                    @foreach (var doctor in Model.CandidateDoctors)
                    {
                        <label class="flex items-center justify-between gap-3 border border-slate-100 rounded-lg px-3 py-2">
                            <span>
                                <span class="font-semibold">@doctor.FullName</span>
                                <span class="block text-xs text-slate-500">@doctor.DepartmentName • @doctor.YearsOfExperience năm</span>
                            </span>
                            <input type="checkbox" name="SelectedDoctorUserIds" value="@doctor.UserId" checked="@(Model.SelectedDoctorUserIds.Contains(doctor.UserId))" class="rounded border-slate-300" />
                        </label>
                    }
                </div>
            </div>

            <div class="bg-violet-50 border border-violet-200 rounded-2xl p-4 text-sm">
                <p class="font-bold text-violet-700">AI Market Insights</p>
                <p class="text-slate-600 mt-1">Nhu cầu thị trường tăng cao. Khuyến nghị tăng cường trực trong mùa cao điểm.</p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a asp-page="/Admin/SpecialtyManagement" class="px-5 py-2 rounded-lg border border-slate-200 text-slate-600 no-underline">Hủy</a>
                <button class="px-5 py-2.5 bg-primary text-white rounded-lg font-semibold">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>
