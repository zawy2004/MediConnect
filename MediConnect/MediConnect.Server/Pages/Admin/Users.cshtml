@page
@model MediConnect.Server.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["UseSidebar"] = true;
    ViewData["SidebarRole"] = "admin";
    ViewData["ActiveSidebar"] = "users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Quản lý Người dùng</h4>
        <p class="text-muted mb-0">Quản lý tài khoản người dùng và phê duyệt bác sĩ</p>
    </div>
</div>

<!-- Tabs -->
<div class="d-flex gap-2 mb-4 p-1 rounded-3" style="background:var(--mc-bg);display:inline-flex">
    <a asp-page="/Admin/Users" asp-route-Tab="all"
       class="btn btn-sm rounded-pill px-4 @(Model.Tab == "all" ? "btn-mc-primary" : "")"
       style="@(Model.Tab != "all" ? "background:transparent;color:var(--mc-text-muted);border:none" : "")">
        Tất cả người dùng
    </a>
    <a asp-page="/Admin/Users" asp-route-Tab="pending"
       class="btn btn-sm rounded-pill px-4 @(Model.Tab == "pending" ? "btn-mc-primary" : "")"
       style="@(Model.Tab != "pending" ? "background:transparent;color:var(--mc-text-muted);border:none" : "")">
        Bác sĩ chờ duyệt
        @if (Model.Tab != "pending")
        {
            <span class="badge rounded-pill ms-1" style="background:#fef3c7;color:#f59e0b;font-size:.7rem">@Model.PendingDoctors.Count</span>
        }
    </a>
</div>

<!-- Search & Filter -->
<form method="get" class="row g-2 mb-4">
    <input type="hidden" name="Tab" value="@Model.Tab" />
    <div class="col-md-5">
        <div class="position-relative">
            <i class="bi bi-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:var(--mc-text-muted)"></i>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="mc-form-control" placeholder="Tìm theo Tên, Email..." style="padding-left:36px" />
        </div>
    </div>
    @if (Model.Tab == "all")
    {
        <div class="col-md-3">
            <select name="RoleFilter" class="mc-form-control" onchange="this.form.submit()">
                <option value="">Tất cả vai trò</option>
                <option value="PATIENT" selected="@(Model.RoleFilter == "PATIENT")">Bệnh nhân</option>
                <option value="DOCTOR" selected="@(Model.RoleFilter == "DOCTOR")">Bác sĩ</option>
                <option value="ADMIN" selected="@(Model.RoleFilter == "ADMIN")">Quản trị viên</option>
            </select>
        </div>
    }
    <div class="col-auto">
        <button type="submit" class="btn btn-mc-primary"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
    </div>
</form>

@if (Model.Tab == "pending")
{
    <!-- Pending Doctors Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3">Bác sĩ chờ phê duyệt</h6>
            @if (Model.PendingDoctors.Any())
            {
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <thead>
                            <tr style="font-size:.8rem;color:var(--mc-text-muted)">
                                <th>Bác sĩ</th>
                                <th>Email</th>
                                <th>Ngày đăng ký</th>
                                <th class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.PendingDoctors)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-semibold text-white" style="width:36px;height:36px;background:var(--mc-primary);font-size:.8rem">
                                                @doc.User.FullName.Substring(0, 1).ToUpper()
                                            </div>
                                            <span class="fw-semibold" style="font-size:.9rem">@doc.User.FullName</span>
                                        </div>
                                    </td>
                                    <td class="text-muted" style="font-size:.85rem">@doc.User.Email</td>
                                    <td class="text-muted" style="font-size:.85rem">@doc.User.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="doctorProfileId" value="@doc.DoctorProfileId" />
                                            <button type="submit" asp-page-handler="Reject" class="btn btn-sm rounded-pill px-3" style="background:#fee2e2;color:#ef4444;border:none;font-size:.8rem">
                                                <i class="bi bi-x-lg me-1"></i>Từ chối
                                            </button>
                                            <button type="submit" asp-page-handler="Approve" class="btn btn-sm rounded-pill px-3 ms-1" style="background:#e6f9ee;color:#22c55e;border:none;font-size:.8rem">
                                                <i class="bi bi-check-lg me-1"></i>Duyệt
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-person-check" style="font-size:2rem"></i>
                    <p class="mt-2 mb-0">Không có bác sĩ nào chờ duyệt</p>
                </div>
            }
        </div>
    </div>
}
else
{
    <!-- All Users Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Danh sách Người dùng Hệ thống</h6>
                <span class="text-muted" style="font-size:.85rem">@Model.Users.Count người dùng</span>
            </div>
            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <thead>
                            <tr style="font-size:.8rem;color:var(--mc-text-muted)">
                                <th>Người dùng</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th>Lần đăng nhập cuối</th>
                                <th class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                var roleColor = user.Role?.RoleName switch
                                {
                                    "ADMIN" => "#8b5cf6",
                                    "DOCTOR" => "#137fec",
                                    _ => "#22c55e"
                                };
                                var roleName = user.Role?.RoleName switch
                                {
                                    "ADMIN" => "Quản trị viên",
                                    "DOCTOR" => "Bác sĩ",
                                    _ => "Bệnh nhân"
                                };
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-semibold text-white" style="width:36px;height:36px;background:@roleColor;font-size:.8rem">
                                                @user.FullName.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <div class="fw-semibold" style="font-size:.9rem">@user.FullName</div>
                                                <div class="text-muted" style="font-size:.75rem">@user.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-2 py-1" style="background:@(roleColor)15;color:@roleColor;font-size:.75rem">@roleName</span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge rounded-pill px-2 py-1" style="background:#e6f9ee;color:#22c55e;font-size:.75rem">
                                                <i class="bi bi-circle-fill me-1" style="font-size:.4rem"></i>Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-2 py-1" style="background:#f1f5f9;color:#94a3b8;font-size:.75rem">
                                                <i class="bi bi-circle-fill me-1" style="font-size:.4rem"></i>Vô hiệu
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted" style="font-size:.85rem">
                                        @(user.LastLoginAt?.ToString("HH:mm dd/MM/yyyy") ?? "Chưa đăng nhập")
                                    </td>
                                    <td class="text-end">
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@user.UserId" />
                                            <button type="submit" asp-page-handler="ToggleActive" class="btn btn-sm rounded-2" style="background:var(--mc-bg);border:none" title="@(user.IsActive ? "Vô hiệu hóa" : "Kích hoạt")">
                                                <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock")" style="color:@(user.IsActive ? "#f59e0b" : "#22c55e")"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-people" style="font-size:2rem"></i>
                    <p class="mt-2 mb-0">Không tìm thấy người dùng nào</p>
                </div>
            }
        </div>
    </div>
}
