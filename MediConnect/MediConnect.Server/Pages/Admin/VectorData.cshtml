@page
@model MediConnect.Server.Pages.Admin.VectorDataModel
@{
    ViewData["Title"] = "Vector Data";
    ViewData["HideLayout"] = true;
}

<div class="min-h-screen bg-[#f8fafc] flex">
    @await Html.PartialAsync("_AdminSidebar", "vector")

    <main class="flex-1 overflow-y-auto">
        <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between">
            <h1 class="text-3xl font-black">Chuẩn hóa dữ liệu sang Vector</h1>
            <a asp-page="/Admin/Dashboard" class="text-slate-500 no-underline">Quay lại dashboard</a>
        </header>

        <div class="p-8 space-y-6">
            <section class="bg-white border rounded-2xl p-5">
                <div class="flex items-center justify-between gap-3">
                    <h2 class="text-lg font-bold">System status</h2>
                    <form method="get">
                        <button type="submit" class="px-3 py-2 bg-slate-900 text-white rounded-xl text-sm">Refresh trạng thái</button>
                    </form>
                </div>
                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                    <div class="border rounded-xl p-3">
                        <p class="text-slate-500">Qdrant</p>
                        <p class="font-semibold @(Model.SystemStatus.QdrantAvailable ? "text-emerald-600" : "text-rose-600")">
                            @(Model.SystemStatus.QdrantAvailable ? "Online" : "Offline")
                        </p>
                        <p class="text-slate-500 mt-1">@Model.SystemStatus.QdrantEndpoint</p>
                    </div>
                    <div class="border rounded-xl p-3">
                        <p class="text-slate-500">Ollama</p>
                        <p class="font-semibold @(Model.SystemStatus.OllamaAvailable ? "text-emerald-600" : "text-rose-600")">
                            @(Model.SystemStatus.OllamaAvailable ? "Online" : "Offline")
                        </p>
                        <p class="text-slate-500 mt-1">@Model.SystemStatus.OllamaEndpoint</p>
                    </div>
                </div>
                <div class="mt-3 text-sm text-slate-600">
                    LLM mode: <span class="font-semibold">@Model.SystemStatus.UseLlm</span>
                    <span class="mx-2">|</span>
                    Embedding: <span class="font-semibold">@(Model.SystemStatus.EmbeddingUseOllama ? "Ollama" : "Fallback local")</span>
                </div>
            </section>

            <section class="bg-white border rounded-2xl p-5">
                <h2 class="text-lg font-bold mb-3">1) Preview dữ liệu sau chuẩn hóa/redaction (dry-run)</h2>
                <form method="post" asp-page-handler="Preview" class="flex flex-wrap items-end gap-3">
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Số lượng bản ghi preview</label>
                        <input asp-for="PreviewLimit" type="number" min="1" max="200" class="rounded-xl border-slate-300" />
                    </div>
                    <button type="submit" class="px-4 py-2 bg-slate-900 text-white rounded-xl">Preview</button>
                </form>

                <div class="mt-4 overflow-auto border rounded-xl">
                    <table class="w-full text-sm">
                        <thead class="bg-slate-50 text-slate-600">
                            <tr>
                                <th class="text-left px-3 py-2">Type</th>
                                <th class="text-left px-3 py-2">SourceId</th>
                                <th class="text-left px-3 py-2">Content (đã chuẩn hóa)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PreviewItems)
                            {
                                <tr class="border-t border-slate-100 align-top">
                                    <td class="px-3 py-2 whitespace-nowrap">@item.Type</td>
                                    <td class="px-3 py-2 whitespace-nowrap">@item.SourceId</td>
                                    <td class="px-3 py-2">@item.Content</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="bg-white border rounded-2xl p-5">
                <h2 class="text-lg font-bold mb-3">2) Index dữ liệu vào Qdrant</h2>
                <form method="post" asp-page-handler="Index">
                    <input type="hidden" asp-for="PreviewLimit" />
                    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-xl">Chuẩn hóa + Tạo vector + Upsert</button>
                </form>

                @if (Model.IndexResult != null)
                {
                    <div class="mt-4 grid grid-cols-1 md:grid-cols-4 gap-3 text-sm">
                        <div class="border rounded-xl p-3"><p class="text-slate-500">Normalized</p><p class="text-xl font-bold">@Model.IndexResult.TotalNormalizedDocuments</p></div>
                        <div class="border rounded-xl p-3"><p class="text-slate-500">Indexed</p><p class="text-xl font-bold">@Model.IndexResult.TotalIndexedDocuments</p></div>
                        <div class="border rounded-xl p-3"><p class="text-slate-500">Failed</p><p class="text-xl font-bold">@Model.IndexResult.FailedDocuments</p></div>
                        <div class="border rounded-xl p-3"><p class="text-slate-500">Errors</p><p class="text-xl font-bold">@Model.IndexResult.Errors.Count</p></div>
                    </div>

                    @if (Model.IndexResult.Errors.Count > 0)
                    {
                        <div class="mt-3 border border-rose-200 bg-rose-50 rounded-xl p-3 text-sm text-rose-700">
                            @foreach (var err in Model.IndexResult.Errors.Take(10))
                            {
                                <p>- @err</p>
                            }
                        </div>
                    }
                }
            </section>

            <section class="bg-white border rounded-2xl p-5">
                <h2 class="text-lg font-bold mb-3">3) Semantic search test</h2>
                <form method="post" asp-page-handler="Search" class="grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
                    <input type="hidden" asp-for="PreviewLimit" />
                    <div class="md:col-span-2">
                        <label class="block text-sm text-slate-600 mb-1">Query</label>
                        <input asp-for="SearchQuery" class="w-full rounded-xl border-slate-300" placeholder="Ví dụ: đau ngực khó thở" />
                    </div>
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">TopK</label>
                        <input asp-for="SearchTopK" type="number" min="1" max="20" class="w-full rounded-xl border-slate-300" />
                    </div>
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Min score</label>
                        <input asp-for="SearchMinScore" type="number" min="0" max="1" step="0.01" class="w-full rounded-xl border-slate-300" />
                    </div>
                    <div class="md:col-span-4">
                        <button type="submit" class="px-4 py-2 bg-slate-900 text-white rounded-xl">Search</button>
                    </div>
                </form>

                @if (Model.SearchResults.Count > 0)
                {
                    <div class="mt-4 space-y-3">
                        @foreach (var item in Model.SearchResults)
                        {
                            <div class="border rounded-xl p-3">
                                <div class="flex items-center justify-between text-sm text-slate-600">
                                    <span>ID: @item.Id</span>
                                    <span>Score: @item.Score.ToString("0.000")</span>
                                </div>
                                <p class="mt-2 text-sm">@item.Content</p>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </main>
</div>
