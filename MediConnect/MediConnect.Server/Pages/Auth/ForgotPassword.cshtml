@page
@model MediConnect.Server.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["HideLayout"] = true;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - MediConnect</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="background:var(--mc-bg);">
    <!-- Navbar -->
    <nav class="navbar mc-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-shield-plus"></i> MediConnect
            </a>
            <div class="d-flex gap-4 align-items-center">
                <a href="#" class="text-decoration-none small fw-medium" style="color:var(--mc-text);">Liên hệ hỗ trợ</a>
                <a href="#" class="text-decoration-none small fw-medium" style="color:var(--mc-text);">Câu hỏi thường gặp</a>
            </div>
        </div>
    </nav>

    <main class="d-flex align-items-center justify-content-center" style="min-height:calc(100vh - 130px);">
        <div class="w-100" style="max-width:500px;padding:0 1rem;">
            <div class="bg-white border rounded-4 shadow-sm p-4 p-md-5" style="border-color:var(--mc-border);">
                <!-- Step Indicator -->
                <div class="d-flex align-items-center justify-content-center gap-2 mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold small" id="dot1" style="width:32px;height:32px;background:var(--mc-primary);">1</div>
                        <span class="small fw-medium">Xác thực Email</span>
                    </div>
                    <div style="width:48px;height:1px;background:var(--mc-border);"></div>
                    <div class="d-flex align-items-center gap-2" id="step2indicator" style="opacity:0.5;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold small" id="dot2" style="width:32px;height:32px;background:var(--mc-border);color:var(--mc-text);">2</div>
                        <span class="small fw-medium">Đặt mật khẩu mới</span>
                    </div>
                </div>

                <!-- Step 1: Email -->
                <div id="step1">
                    <h1 class="fw-bold text-center mb-2" style="font-size:1.5rem;">Đặt lại mật khẩu của bạn</h1>
                    <p class="text-center mb-4" style="color:var(--mc-text-muted);font-size:0.95rem;">Nhập địa chỉ email để nhận mã khôi phục bảo mật.</p>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3 py-2 small"><i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success rounded-3 py-2 small"><i class="bi bi-check-circle"></i> @Model.SuccessMessage</div>
                    }

                    <form method="post" asp-page-handler="SendCode">
                        <div class="mb-4">
                            <label class="form-label fw-medium small">Địa chỉ Email</label>
                            <input asp-for="Email" class="form-control mc-form-control" placeholder="vd: benhnhan@email.com" style="height:52px;" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-mc-primary w-100" style="height:52px;font-size:1rem;">
                            Gửi mã xác thực
                        </button>
                    </form>
                    <div class="text-center mt-3">
                        <a asp-page="/Auth/Login" class="text-decoration-none fw-semibold small" style="color:var(--mc-primary);">Quay lại đăng nhập</a>
                    </div>

                    <div class="rounded-3 p-3 mt-4 d-flex gap-3" style="background:#f8fafc;border:1px solid var(--mc-border);">
                        <i class="bi bi-shield-lock text-primary"></i>
                        <div>
                            <div class="fw-bold small" style="letter-spacing:0.05em;">MÃ HÓA BẢO MẬT</div>
                            <p class="small mb-0" style="color:var(--mc-text-muted);">Dữ liệu được bảo vệ theo tiêu chuẩn HIPAA.</p>
                        </div>
                    </div>
                </div>

                <!-- Step 2: New Password -->
                <div id="step2" class="d-none">
                    <h1 class="fw-bold text-center mb-2" style="font-size:1.5rem;">Tạo mật khẩu mới</h1>
                    <p class="text-center mb-4" style="color:var(--mc-text-muted);font-size:0.9rem;">Mã xác thực đã gửi. Vui lòng thiết lập mật khẩu mới.</p>

                    <form method="post" asp-page-handler="ResetPassword">
                        <input type="hidden" asp-for="Email" />
                        <div class="mb-3">
                            <label class="form-label fw-medium small">Mã xác thực</label>
                            <input asp-for="Token" class="form-control mc-form-control text-center fw-bold" style="height:48px;letter-spacing:0.5em;font-size:1.2rem;" placeholder="000000" />
                            <p class="small mt-1" style="color:var(--mc-text-muted);">Kiểm tra email (bao gồm thư rác).</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium small">Mật khẩu mới</label>
                            <div class="position-relative">
                                <input asp-for="NewPassword" type="password" id="newPwd" class="form-control mc-form-control" style="height:48px;padding-right:2.5rem;" />
                                <button type="button" class="btn btn-link position-absolute top-50 translate-middle-y border-0 p-0" style="right:14px;color:var(--mc-text-muted);" onclick="togglePwd('newPwd',this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <!-- Strength -->
                            <div class="d-flex justify-content-between align-items-center mt-2 mb-1">
                                <span class="small" style="color:var(--mc-text-muted);">Độ mạnh: <strong id="strLabel" style="color:var(--mc-primary);">-</strong></span>
                            </div>
                            <div class="d-flex gap-1">
                                <div class="flex-grow-1 rounded" style="height:6px;background:#e2e8f0;" id="s1"></div>
                                <div class="flex-grow-1 rounded" style="height:6px;background:#e2e8f0;" id="s2"></div>
                                <div class="flex-grow-1 rounded" style="height:6px;background:#e2e8f0;" id="s3"></div>
                                <div class="flex-grow-1 rounded" style="height:6px;background:#e2e8f0;" id="s4"></div>
                            </div>
                        </div>

                        <div class="rounded-3 p-3 mb-3" style="background:#f0f9ff;border:1px solid #bae6fd;">
                            <h6 class="fw-bold small mb-2">Yêu cầu mật khẩu:</h6>
                            <ul class="list-unstyled small mb-0" style="color:var(--mc-text-muted);">
                                <li class="mb-1" id="req1"><i class="bi bi-circle me-2 small"></i> Ít nhất 8 ký tự</li>
                                <li class="mb-1" id="req2"><i class="bi bi-circle me-2 small"></i> Chứa chữ số</li>
                                <li id="req3"><i class="bi bi-circle me-2 small"></i> Chứa ký tự đặc biệt</li>
                            </ul>
                        </div>

                        <button type="submit" class="btn btn-mc-primary w-100 mt-2" style="height:52px;font-size:1rem;">
                            Cập nhật mật khẩu
                        </button>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="small" style="color:var(--mc-text-muted);">
                    Cần hỗ trợ? <a href="#" class="fw-semibold text-decoration-none" style="color:var(--mc-primary);">Trò chuyện với chuyên gia bảo mật</a>
                </p>
                <div class="d-flex justify-content-center gap-4 mt-2">
                    <span class="d-flex align-items-center gap-1 small" style="color:var(--mc-text-muted);"><i class="bi bi-lock"></i> Bảo mật HIPAA</span>
                    <span class="d-flex align-items-center gap-1 small" style="color:var(--mc-text-muted);"><i class="bi bi-shield-check"></i> Mã hóa 256-bit</span>
                </div>
            </div>
        </div>
    </main>

<script>
    // If token was sent, show step 2
    @if (Model.ShowStep2)
    {
        <text>
        document.getElementById('step1').classList.add('d-none');
        document.getElementById('step2').classList.remove('d-none');
        document.getElementById('step2indicator').style.opacity = '1';
        document.getElementById('dot1').style.background = 'var(--mc-success)';
        document.getElementById('dot2').style.background = 'var(--mc-primary)';
        document.getElementById('dot2').classList.add('text-white');
        </text>
    }

    function togglePwd(id, btn) {
        const el = document.getElementById(id);
        const ic = btn.querySelector('i');
        el.type = el.type === 'password' ? 'text' : 'password';
        ic.classList.toggle('bi-eye');
        ic.classList.toggle('bi-eye-slash');
    }

    document.getElementById('newPwd')?.addEventListener('input', function () {
        const v = this.value;
        let str = 0;
        const labels = ['Yếu', 'Trung bình', 'Mạnh', 'Rất mạnh'];
        const colors = ['#ef4444', '#f59e0b', '#06b6d4', '#10b981'];
        if (v.length >= 8) str++;
        if (/[A-Z]/.test(v)) str++;
        if (/\d/.test(v)) str++;
        if (/[^A-Za-z0-9]/.test(v)) str++;
        document.getElementById('strLabel').textContent = str > 0 ? labels[str - 1] : '-';
        document.getElementById('strLabel').style.color = str > 0 ? colors[str - 1] : 'var(--mc-text-muted)';
        for (let i = 1; i <= 4; i++) {
            document.getElementById('s' + i).style.background = i <= str ? colors[str - 1] : '#e2e8f0';
        }
        // Requirements
        setReq('req1', v.length >= 8);
        setReq('req2', /\d/.test(v));
        setReq('req3', /[^A-Za-z0-9]/.test(v));
    });

    function setReq(id, met) {
        const el = document.getElementById(id);
        const icon = el.querySelector('i');
        if (met) {
            icon.className = 'bi bi-check-circle-fill me-2 small text-success';
        } else {
            icon.className = 'bi bi-circle me-2 small';
        }
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
