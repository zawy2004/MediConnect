@page
@model MediConnect.Server.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["HideLayout"] = true;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - MediConnect</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="auth-layout">
    <!-- Left Hero Panel -->
    <div class="auth-hero d-none d-lg-flex" style="width:60%;">
        <div class="position-relative z-1 text-center" style="max-width:600px;">
            <div class="d-flex align-items-center gap-2 justify-content-center mb-4">
                <i class="bi bi-shield-plus text-primary" style="font-size:2.5rem;"></i>
                <h1 class="fw-bold mb-0" style="color:var(--mc-primary);font-size:1.75rem;">MediConnect</h1>
            </div>
            <h2 class="fw-bold mb-3" style="font-size:2.5rem;line-height:1.2;">Kết nối để nâng tầm y tế.</h2>
            <p style="color:var(--mc-text-muted);font-size:1.1rem;max-width:480px;margin:0 auto;">
                Nền tảng hợp nhất giúp bệnh nhân và chuyên gia y tế quản lý lịch hẹn, hồ sơ sức khỏe và giao tiếp liền mạch.
            </p>
            <div class="mt-4 rounded-4 overflow-hidden shadow-lg mx-auto" style="max-width:500px;border:6px solid rgba(255,255,255,0.5);">
                <div style="background:linear-gradient(135deg,#dbeafe,#c7d2fe);height:300px;display:flex;align-items:center;justify-content:center;">
                    <i class="bi bi-heart-pulse" style="font-size:6rem;color:var(--mc-primary);opacity:0.3;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Form Panel -->
    <div class="auth-form-panel" style="width:40%;min-width:380px;">
        <div style="width:100%;max-width:420px;">
            <!-- Mobile Logo -->
            <div class="d-lg-none d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-shield-plus text-primary fs-4"></i>
                <span class="fw-bold fs-5" style="color:var(--mc-primary);">MediConnect</span>
            </div>

            <div class="mb-4">
                <h3 class="fw-bold" style="font-size:1.75rem;">Chào mừng trở lại</h3>
                <p style="color:var(--mc-text-muted);">Vui lòng nhập thông tin để đăng nhập.</p>
            </div>

            <!-- Role Toggle -->
            <div class="mb-4">
                <p class="fw-bold small mb-2">Đăng nhập với tư cách:</p>
                <div class="d-flex rounded-3 p-1" style="background:#f1f5f9;">
                    <label class="flex-grow-1 text-center py-2 rounded-2 fw-bold small cursor-pointer" style="cursor:pointer;">
                        <input type="radio" name="loginRole" value="Patient" checked class="d-none" onchange="this.parentElement.classList.add('bg-white','shadow-sm','text-primary');this.parentElement.nextElementSibling?.classList.remove('bg-white','shadow-sm','text-primary');" />
                        <span>Bệnh nhân</span>
                    </label>
                    <label class="flex-grow-1 text-center py-2 rounded-2 fw-bold small" style="color:var(--mc-text-muted);cursor:pointer;">
                        <input type="radio" name="loginRole" value="Doctor" class="d-none" onchange="this.parentElement.classList.add('bg-white','shadow-sm','text-primary');this.parentElement.previousElementSibling?.classList.remove('bg-white','shadow-sm','text-primary');" />
                        <span>Bác sĩ</span>
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 rounded-3 small">
                    <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
                </div>
            }

            <form method="post" class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label fw-bold small">Địa chỉ Email</label>
                    <div class="position-relative">
                        <i class="bi bi-envelope position-absolute top-50 translate-middle-y" style="left:14px;color:var(--mc-text-muted);"></i>
                        <input asp-for="Email" class="form-control mc-form-control" style="padding-left:2.5rem;height:52px;" placeholder="example@mediconnect.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div>
                    <label class="form-label fw-bold small">Mật khẩu</label>
                    <div class="position-relative">
                        <i class="bi bi-lock position-absolute top-50 translate-middle-y" style="left:14px;color:var(--mc-text-muted);"></i>
                        <input asp-for="Password" type="password" id="loginPassword" class="form-control mc-form-control" style="padding-left:2.5rem;padding-right:2.5rem;height:52px;" placeholder="••••••••" />
                        <button type="button" class="btn btn-link position-absolute top-50 translate-middle-y border-0 p-0" style="right:14px;color:var(--mc-text-muted);" onclick="togglePasswordVisibility('loginPassword', this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between">
                    <label class="d-flex align-items-center gap-2 small" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input" style="width:18px;height:18px;" />
                        <span style="color:var(--mc-text-muted);">Ghi nhớ mật khẩu</span>
                    </label>
                    <a asp-page="/Auth/ForgotPassword" class="small fw-bold text-decoration-none" style="color:var(--mc-primary);">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-mc-primary w-100 mt-2" style="height:52px;font-size:1rem;">
                    Đăng nhập
                </button>

                <!-- Divider -->
                <div class="position-relative my-3">
                    <hr />
                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 small fw-bold" style="color:var(--mc-text-muted);letter-spacing:0.1em;">HOẶC TIẾP TỤC VỚI</span>
                </div>

                <!-- Social Login -->
                <div class="row g-2">
                    <div class="col-4">
                        <button type="button" class="btn btn-mc-outline w-100 d-flex flex-column align-items-center gap-1 py-2">
                            <svg width="20" height="20" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.66l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                            <span style="font-size:0.65rem;font-weight:700;">Google</span>
                        </button>
                    </div>
                    <div class="col-4">
                        <button type="button" class="btn btn-mc-outline w-100 d-flex flex-column align-items-center gap-1 py-2">
                            <i class="bi bi-facebook" style="color:#1877F2;font-size:1.2rem;"></i>
                            <span style="font-size:0.65rem;font-weight:700;">Facebook</span>
                        </button>
                    </div>
                    <div class="col-4">
                        <button type="button" class="btn btn-mc-outline w-100 d-flex flex-column align-items-center gap-1 py-2">
                            <i class="bi bi-apple" style="font-size:1.2rem;"></i>
                            <span style="font-size:0.65rem;font-weight:700;">Apple</span>
                        </button>
                    </div>
                </div>
            </form>

            <div class="text-center mt-4">
                <p class="small" style="color:var(--mc-text-muted);">
                    Chưa có tài khoản?
                    <a asp-page="/Auth/Register" class="fw-bold text-decoration-none" style="color:var(--mc-primary);">Đăng ký ngay</a>
                </p>
            </div>

            <div class="mt-4 pt-4 border-top d-flex justify-content-center gap-4" style="opacity:0.5;">
                <span style="font-size:0.65rem;letter-spacing:0.1em;font-weight:700;">
                    <i class="bi bi-shield-check"></i> TUÂN THỦ HIPAA
                </span>
                <span style="font-size:0.65rem;letter-spacing:0.1em;font-weight:700;">
                    <i class="bi bi-lock"></i> MÃ HÓA SSL 256-BIT
                </span>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }

    // Init role toggle
    document.addEventListener('DOMContentLoaded', function() {
        const firstLabel = document.querySelector('label:has(input[value="Patient"])');
        if (firstLabel) firstLabel.classList.add('bg-white', 'shadow-sm', 'text-primary');
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
