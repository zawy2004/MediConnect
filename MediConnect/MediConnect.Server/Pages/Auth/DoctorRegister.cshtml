@page
@model MediConnect.Server.Pages.Auth.DoctorRegisterModel
@{
    ViewData["Title"] = "Đăng ký Bác sĩ";
    ViewData["HideLayout"] = true;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký Chuyên môn Bác sĩ - MediConnect</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="background:var(--mc-bg);">
    <!-- Navbar -->
    <nav class="navbar mc-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-shield-plus"></i> MediConnect
            </a>
            <div class="d-flex gap-3 align-items-center">
                <a asp-page="/Auth/Login" class="text-decoration-none small fw-medium" style="color:var(--mc-text);">Quay lại Đăng nhập</a>
                <a href="#" class="btn btn-mc-primary btn-sm">Hỗ trợ</a>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <!-- Header -->
                <div class="mb-4">
                    <h1 class="fw-black mb-2" style="font-size:2rem;">Đăng ký Chuyên môn Bác sĩ</h1>
                    <p style="color:var(--mc-text-muted);">Hoàn tất hồ sơ chuyên môn để bắt đầu kết nối với bệnh nhân.</p>
                </div>

                <!-- Step Progress -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-medium" id="stepLabel">Bước 1: Thông tin Tài khoản</span>
                        <span class="small" style="color:var(--mc-text);" id="stepPercent">33% Hoàn thành</span>
                    </div>
                    <div class="progress" style="height:8px;border-radius:9999px;background:var(--mc-border);">
                        <div class="progress-bar" id="progressBar" style="width:33%;background:var(--mc-primary);border-radius:9999px;transition:width 0.5s;"></div>
                    </div>
                    <p class="small mt-2" style="color:var(--mc-text-muted);" id="stepHint">Sắp xong rồi! Quy trình xác thực của bạn sẽ bắt đầu sau khi gửi hồ sơ.</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger rounded-3 py-2"><i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage</div>
                }

                <form method="post" id="doctorRegForm">
                    <!-- Step 1: Account Info -->
                    <div id="step1" class="step-content">
                        <div class="bg-white rounded-4 border mb-4" style="border-color:var(--mc-border);">
                            <h2 class="fw-bold px-4 pt-4 pb-3 border-bottom" style="font-size:1.15rem;border-color:var(--mc-border)!important;">Thông tin Tài khoản</h2>
                            <div class="p-4">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Họ và tên</label>
                                        <input asp-for="FullName" class="form-control mc-form-control" placeholder="Nguyễn Văn A" style="height:48px;" />
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Email</label>
                                        <input asp-for="Email" class="form-control mc-form-control" placeholder="bacsi@email.com" style="height:48px;" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Số điện thoại</label>
                                        <input asp-for="PhoneNumber" class="form-control mc-form-control" placeholder="0901234567" style="height:48px;" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Mật khẩu</label>
                                        <div class="position-relative">
                                            <input asp-for="Password" type="password" id="drPassword" class="form-control mc-form-control" style="height:48px;padding-right:2.5rem;" />
                                            <button type="button" class="btn btn-link position-absolute top-50 translate-middle-y border-0 p-0" style="right:14px;color:var(--mc-text-muted);" onclick="togglePwd('drPassword',this)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Xác nhận mật khẩu</label>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control mc-form-control" style="height:48px;" />
                                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Professional Certification -->
                    <div id="step2" class="step-content d-none">
                        <div class="bg-white rounded-4 border mb-4" style="border-color:var(--mc-border);">
                            <h2 class="fw-bold px-4 pt-4 pb-3 border-bottom" style="font-size:1.15rem;border-color:var(--mc-border)!important;">Danh tính Chuyên môn</h2>
                            <div class="p-4">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Số Giấy phép Hành nghề Y tế</label>
                                        <input asp-for="LicenseNumber" class="form-control mc-form-control" placeholder="VD: 1234567890" style="height:48px;" />
                                        <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Cơ quan Cấp phép</label>
                                        <input asp-for="Education" class="form-control mc-form-control" placeholder="VD: Sở Y tế Hà Nội" style="height:48px;" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-4 border mb-4" style="border-color:var(--mc-border);">
                            <h2 class="fw-bold px-4 pt-4 pb-3 border-bottom" style="font-size:1.15rem;border-color:var(--mc-border)!important;">Chuyên môn Lâm sàng</h2>
                            <div class="p-4">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Chuyên khoa Chính</label>
                                        <select asp-for="SpecialtyId" class="form-select mc-form-control" style="height:48px;">
                                            <option value="">Chọn chuyên khoa của bạn</option>
                                            @foreach (var s in Model.Specialties)
                                            {
                                                <option value="@s.SpecialtyId">@s.SpecialtyName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Số năm Kinh nghiệm</label>
                                        <input asp-for="YearsOfExperience" type="number" class="form-control mc-form-control" min="0" max="60" placeholder="Số năm kinh nghiệm" style="height:48px;" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Phí tư vấn (VNĐ)</label>
                                        <input asp-for="ConsultationFee" type="number" class="form-control mc-form-control" min="0" placeholder="VD: 300000" style="height:48px;" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Khoa / Phòng ban</label>
                                        <select asp-for="DepartmentId" class="form-select mc-form-control" style="height:48px;">
                                            <option value="">Chọn khoa</option>
                                            @foreach (var d in Model.Departments)
                                            {
                                                <option value="@d.DepartmentId">@d.DepartmentName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Verification Documents / Bio -->
                    <div id="step3" class="step-content d-none">
                        <div class="bg-white rounded-4 border mb-4" style="border-color:var(--mc-border);">
                            <h2 class="fw-bold px-4 pt-4 pb-3 border-bottom" style="font-size:1.15rem;border-color:var(--mc-border)!important;">Tài liệu Xác thực</h2>
                            <div class="p-4">
                                <div class="border border-2 rounded-4 p-5 text-center" style="border-style:dashed!important;border-color:var(--mc-border);background:#f8fafc;cursor:pointer;" id="uploadArea">
                                    <div class="d-flex justify-content-center mb-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:64px;height:64px;background:var(--mc-primary-light);">
                                            <i class="bi bi-cloud-upload text-primary" style="font-size:2rem;"></i>
                                        </div>
                                    </div>
                                    <p class="fw-bold mb-1" style="font-size:1.1rem;">Tải lên Chứng chỉ Chuyên môn</p>
                                    <p class="small mb-2" style="color:var(--mc-text-muted);">Kéo và thả bằng cấp hoặc chứng chỉ y tế của bạn vào đây</p>
                                    <p class="small fst-italic" style="color:var(--mc-text-muted);">Hỗ trợ PDF, JPG, PNG (Tối đa 10MB)</p>
                                    <button type="button" class="btn btn-mc-outline btn-sm mt-2">Chọn Tệp</button>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-4 border mb-4" style="border-color:var(--mc-border);">
                            <h2 class="fw-bold px-4 pt-4 pb-3 border-bottom" style="font-size:1.15rem;border-color:var(--mc-border)!important;">Giới thiệu Bản thân</h2>
                            <div class="p-4">
                                <textarea asp-for="Bio" class="form-control mc-form-control" rows="4" placeholder="Viết vài dòng giới thiệu về bản thân, kinh nghiệm và phương pháp điều trị..."></textarea>
                            </div>
                        </div>

                        <!-- Info about approval -->
                        <div class="rounded-3 p-4 mb-4 d-flex gap-3" style="background:#eff6ff;border:1px solid #bfdbfe;">
                            <i class="bi bi-info-circle" style="color:#2563eb;font-size:1.25rem;"></i>
                            <div>
                                <p class="fw-bold small mb-1" style="color:#1e40af;">Trạng thái tài khoản: Chờ phê duyệt</p>
                                <p class="small mb-0" style="color:#1d4ed8;">
                                    Đăng ký của bạn cần được quản trị viên phê duyệt. Hội đồng y tế sẽ xác minh trong vòng 24-48 giờ.
                                    Bạn sẽ nhận thông báo qua email khi hồ sơ được kích hoạt.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div class="d-flex justify-content-between align-items-center pt-3 pb-5">
                        <div class="d-flex align-items-center gap-2 small" style="color:var(--mc-text-muted);">
                            <i class="bi bi-lock text-success"></i>
                            <span>Dữ liệu mã hóa theo tiêu chuẩn HIPAA</span>
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" id="btnBack" class="btn btn-mc-outline d-none" onclick="changeStep(-1)" style="min-width:120px;height:48px;">
                                Quay lại
                            </button>
                            <button type="button" id="btnNext" class="btn btn-mc-primary" onclick="changeStep(1)" style="min-width:160px;height:48px;">
                                Tiếp tục
                            </button>
                            <button type="submit" id="btnSubmit" class="btn btn-mc-primary d-none" style="min-width:180px;height:48px;">
                                <i class="bi bi-check-circle"></i> Hoàn tất Đăng ký
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </main>

<script>
    let currentStep = 1;
    const steps = ['Bước 1: Thông tin Tài khoản', 'Bước 2: Chứng chỉ Chuyên môn', 'Bước 3: Xác thực & Hoàn tất'];
    const percents = [33, 66, 100];

    function changeStep(dir) {
        const ns = currentStep + dir;
        if (ns < 1 || ns > 3) return;
        document.getElementById('step' + currentStep).classList.add('d-none');
        document.getElementById('step' + ns).classList.remove('d-none');
        currentStep = ns;
        updateUI();
    }

    function updateUI() {
        document.getElementById('stepLabel').textContent = steps[currentStep - 1];
        document.getElementById('stepPercent').textContent = percents[currentStep - 1] + '% Hoàn thành';
        document.getElementById('progressBar').style.width = percents[currentStep - 1] + '%';
        document.getElementById('btnBack').classList.toggle('d-none', currentStep === 1);
        document.getElementById('btnNext').classList.toggle('d-none', currentStep === 3);
        document.getElementById('btnSubmit').classList.toggle('d-none', currentStep !== 3);
    }

    function togglePwd(id, btn) {
        const el = document.getElementById(id);
        const ic = btn.querySelector('i');
        el.type = el.type === 'password' ? 'text' : 'password';
        ic.classList.toggle('bi-eye');
        ic.classList.toggle('bi-eye-slash');
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
