@page
@model MediConnect.Server.Pages.Doctor.ProfessionalRegistrationModel
@{
    ViewData["Title"] = "Đăng ký Chuyên môn Bác sĩ";
}

<div class="min-h-screen bg-[#f8fafc]">
    <div class="max-w-[980px] mx-auto px-6 py-8 space-y-6">
        <div class="bg-gradient-to-r from-blue-700 to-blue-600 text-white rounded-2xl p-8">
            <h1 class="text-5xl font-black">Đăng ký Chuyên môn Bác sĩ</h1>
        <p class="text-blue-100 mt-1">Hoàn tất hồ sơ chuyên môn để kết nối với bệnh nhân.</p>
            <div class="mt-5">
                <div class="h-2 bg-white/20 rounded-full overflow-hidden"><div class="h-full w-2/3 bg-white"></div></div>
                <p class="text-xs mt-2 text-blue-100">Tiến độ hồ sơ: 66%</p>
            </div>
        </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl px-4 py-3">@Model.StatusMessage</div>
    }

        <form method="post" class="bg-white border rounded-2xl p-6 space-y-5">
        <section class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <h2 class="text-lg font-bold mb-3">Thông tin dịch vụ</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="text-sm text-slate-500">Bảo hiểm hỗ trợ</label>
                <input asp-for="InsuranceAccepted" class="w-full mt-1 rounded-lg border-slate-200" />
            </div>
            <div>
                <label class="text-sm text-slate-500">Địa điểm khám</label>
                <input asp-for="Location" class="w-full mt-1 rounded-lg border-slate-200" />
            </div>
        </div>
        </section>

        <section class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <h2 class="text-lg font-bold mb-3">Mức giá & mô tả</h2>
        <div>
            <label class="text-sm text-slate-500">Phí khám</label>
            <input asp-for="ConsultationFee" class="w-full mt-1 rounded-lg border-slate-200" />
        </div>
        <div>
            <label class="text-sm text-slate-500">Mô tả chuyên môn</label>
            <textarea asp-for="Bio" rows="5" class="w-full mt-1 rounded-lg border-slate-200"></textarea>
        </div>
        </section>
            <button class="px-5 py-2.5 bg-primary text-white rounded-xl font-semibold">Hoàn tất Đăng ký</button>
        </form>
    </div>
</div>
