@page
@model MediConnect.Server.Pages.Doctor.DashboardModel
@{
    ViewData["Title"] = "Dashboard bác sĩ";
    ViewData["HideLayout"] = true;
}

<div class="min-h-screen bg-[#f8fafc] flex">
    @await Html.PartialAsync("_DoctorSidebar", "dashboard")
    <main class="flex-1 overflow-y-auto p-8 space-y-6">
        <section class="flex items-center justify-between gap-4">
            <div>
                <h1 class="text-4xl md:text-5xl font-black">Bảng điều khiển Bác sĩ</h1>
                <p class="text-slate-500 mt-1">Xin chào @Model.Data.DoctorName • @Model.Data.DepartmentName</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="hidden lg:flex items-center gap-2 px-3 py-2 rounded-xl border bg-white border-slate-200 text-slate-500 min-w-[280px]">
                    <span class="material-symbols-outlined text-base">search</span>
                    <span class="text-sm">Tìm bệnh nhân, lịch hẹn...</span>
                </div>
                <button type="button" class="size-10 rounded-xl border bg-white border-slate-200 text-slate-500"><span class="material-symbols-outlined">notifications</span></button>
                <a asp-page="/Doctor/Profile" class="px-4 py-2 border border-slate-300 rounded-xl no-underline bg-white">Cập nhật hồ sơ</a>
            </div>
        </section>

    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white border rounded-2xl p-5"><p class="text-slate-500 text-xs uppercase tracking-wider">Tổng số bệnh nhân</p><p class="text-4xl font-black mt-2">@Model.Data.TotalPatients</p></div>
        <div class="bg-white border rounded-2xl p-5"><p class="text-slate-500 text-xs uppercase tracking-wider">Mức độ hài lòng</p><p class="text-4xl font-black mt-2">@Model.Data.SatisfactionPercent%</p></div>
        <div class="bg-white border rounded-2xl p-5"><p class="text-slate-500 text-xs uppercase tracking-wider">Lịch hẹn trong tháng</p><p class="text-4xl font-black mt-2">@Model.Data.AppointmentsThisMonth</p></div>
        <div class="bg-white border rounded-2xl p-5"><p class="text-slate-500 text-xs uppercase tracking-wider">Thời gian khám TB</p><p class="text-4xl font-black mt-2">@Model.Data.AverageConsultationMinutes phút</p></div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white border rounded-2xl p-6">
            <h2 class="text-2xl font-black mb-4">Lịch trình hôm nay</h2>
            @if (Model.Data.TodayTimeline.Count == 0)
            {
                <p class="text-slate-500">Không có lịch hẹn trong ngày.</p>
            }
            else
            {
                <div class="space-y-3 relative before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-px before:bg-slate-200">
                    @foreach (var item in Model.Data.TodayTimeline)
                    {
                        <div class="border border-slate-200 rounded-2xl p-4 flex items-center justify-between gap-3 bg-white relative pl-10">
                            <span class="absolute left-[7px] top-1/2 -translate-y-1/2 size-2.5 rounded-full bg-primary"></span>
                            <div class="min-w-0">
                                <p class="font-semibold">@item.PatientName</p>
                                <p class="text-sm text-slate-500">@item.StartTime.ToString("HH:mm") • @item.Reason</p>
                            </div>
                            <span class="px-2 py-1 text-xs rounded-full @Model.GetBadgeClass(item.Status)">@item.Status</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="space-y-4">
            <div class="bg-white border rounded-2xl p-5">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-xl font-black">Yêu cầu chờ duyệt</h2>
                <a asp-page="/Doctor/ConfirmAppointmentRequest" class="text-primary text-sm no-underline">Xem tất cả</a>
            </div>
            <div class="space-y-3">
                @foreach (var req in Model.Data.PendingRequests)
                {
                    <div class="border border-slate-200 rounded-xl p-3">
                        <p class="font-semibold">@req.PatientName</p>
                        <p class="text-xs text-slate-500">@req.AppointmentDate.ToString("dd/MM/yyyy") • @req.StartTime.ToString("HH:mm")</p>
                        <div class="flex items-center gap-2 mt-3">
                            <form method="post" asp-page-handler="Confirm">
                                <input type="hidden" name="appointmentId" value="@req.AppointmentId" />
                                <button type="submit" class="px-3 py-1.5 bg-primary text-white rounded-lg text-xs">Chấp nhận</button>
                            </form>
                            <form method="post" asp-page-handler="Reject">
                                <input type="hidden" name="appointmentId" value="@req.AppointmentId" />
                                <input type="hidden" name="reason" value="Bác sĩ từ chối do không phù hợp khung giờ." />
                                <button type="submit" class="px-3 py-1.5 bg-slate-200 text-slate-700 rounded-lg text-xs">Từ chối</button>
                            </form>
                        </div>
                    </div>
                }
                @if (Model.Data.PendingRequests.Count == 0)
                {
                    <p class="text-sm text-slate-500">Không có yêu cầu chờ duyệt.</p>
                }
            </div>
        </div>
            <div class="bg-gradient-to-br from-blue-600 to-blue-700 text-white rounded-2xl p-5">
                <h3 class="font-bold text-xl">Mục tiêu tháng</h3>
                <p class="text-sm mt-2">Bác sĩ đã hoàn thành 85% chỉ tiêu số lượng cuộc hẹn trong tháng này.</p>
                <a asp-page="/Doctor/PerformanceAnalysis" class="mt-4 inline-block px-4 py-2 bg-white/10 border border-white/30 rounded-xl text-white no-underline">Xem chi tiết hiệu suất</a>
            </div>
            <div class="bg-white border rounded-2xl p-5">
                <h3 class="text-lg font-black mb-3">Lịch tuần này</h3>
                <div class="grid grid-cols-7 gap-2 text-center text-xs">
                    @foreach (var day in new[] { "T2", "T3", "T4", "T5", "T6", "T7", "CN" })
                    {
                        <div class="py-2 rounded-lg bg-slate-50 border border-slate-200">@day</div>
                    }
                </div>
            </div>
        </div>
    </section>
    </main>
</div>
