@page
@model MediConnect.Server.Pages.Doctor.ProfileModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["UseSidebar"] = true;
    ViewData["SidebarRole"] = "doctor";
    ViewData["ActiveSidebar"] = "profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Hồ sơ cá nhân</h4>
        <p class="text-muted mb-0">Quản lý thông tin cá nhân và chuyên môn</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 fw-bold text-white" style="width:80px;height:80px;background:var(--mc-primary);font-size:2rem">
                    @(Model.DoctorProfile?.User?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                </div>
                <h5 class="fw-bold mb-1">@Model.DoctorProfile?.User?.FullName</h5>
                <p class="text-muted mb-2" style="font-size:.9rem">@(Model.DoctorProfile?.Department?.DepartmentName ?? "Chưa phân khoa")</p>
                <div class="d-flex justify-content-center gap-1 mb-3">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var rating = (double)(Model.DoctorProfile?.AverageRating ?? 0);
                        <i class="bi @(i <= Math.Floor(rating) ? "bi-star-fill" : (i - 0.5 <= rating ? "bi-star-half" : "bi-star"))" style="color:#f59e0b"></i>
                    }
                    <span class="text-muted ms-1" style="font-size:.85rem">(@(Model.DoctorProfile?.TotalReviews ?? 0))</span>
                </div>
                @{
                    var statusColor = Model.DoctorProfile?.ApprovalStatus switch
                    {
                        "APPROVED" => "#22c55e",
                        "PENDING" => "#f59e0b",
                        _ => "#ef4444"
                    };
                    var statusText = Model.DoctorProfile?.ApprovalStatus switch
                    {
                        "APPROVED" => "Đã duyệt",
                        "PENDING" => "Chờ duyệt",
                        _ => "Từ chối"
                    };
                }
                <span class="badge rounded-pill px-3 py-2" style="background:@(statusColor)15;color:@statusColor">
                    <i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>@statusText
                </span>

                <hr class="my-3">

                <div class="text-start d-flex flex-column gap-2">
                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size:.85rem">
                        <i class="bi bi-envelope"></i>
                        <span>@Model.DoctorProfile?.User?.Email</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size:.85rem">
                        <i class="bi bi-telephone"></i>
                        <span>@(Model.PhoneNumber ?? "Chưa cập nhật")</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size:.85rem">
                        <i class="bi bi-geo-alt"></i>
                        <span>@(Model.Location ?? "Chưa cập nhật")</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size:.85rem">
                        <i class="bi bi-award"></i>
                        <span>@(Model.DoctorProfile?.LicenseNumber ?? "Chưa cập nhật")</span>
                    </div>
                </div>

                @if (Model.DoctorSpecialties.Any())
                {
                    <hr class="my-3">
                    <h6 class="fw-semibold text-start mb-2" style="font-size:.85rem">Chuyên khoa</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var spec in Model.DoctorSpecialties)
                        {
                            <span class="badge rounded-pill px-3 py-2" style="background:var(--mc-primary-light);color:var(--mc-primary);font-size:.8rem">
                                @spec.SpecialtyName
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Edit Form -->
    <div class="col-lg-8">
        <form method="post">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-person me-2"></i>Thông tin cá nhân</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" style="font-size:.85rem">Họ và tên</label>
                            <input type="text" class="mc-form-control" asp-for="FullName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" style="font-size:.85rem">Số điện thoại</label>
                            <input type="tel" class="mc-form-control" asp-for="PhoneNumber" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium" style="font-size:.85rem">Địa chỉ</label>
                            <input type="text" class="mc-form-control" asp-for="Address" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-briefcase me-2"></i>Thông tin chuyên môn</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-medium" style="font-size:.85rem">Giới thiệu bản thân</label>
                            <textarea class="mc-form-control" asp-for="Bio" rows="4" placeholder="Mô tả ngắn gọn về bản thân và kinh nghiệm..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium" style="font-size:.85rem">Học vấn</label>
                            <textarea class="mc-form-control" asp-for="Education" rows="3" placeholder="Bằng cấp, chứng chỉ, nơi đào tạo..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium" style="font-size:.85rem">Địa điểm khám</label>
                            <input type="text" class="mc-form-control" asp-for="Location" placeholder="Bệnh viện, phòng khám..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium" style="font-size:.85rem">Phí khám (VNĐ)</label>
                            <input type="number" class="mc-form-control" asp-for="ConsultationFee" min="0" step="10000" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium" style="font-size:.85rem">Bảo hiểm</label>
                            <select class="mc-form-control" asp-for="InsuranceAccepted">
                                <option value="true">Chấp nhận</option>
                                <option value="false">Không</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="/Doctor/Index" class="btn btn-mc-outline px-4">Hủy</a>
                <button type="submit" class="btn btn-mc-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>
