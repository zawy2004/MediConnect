@page
@model MediConnect.Server.Pages.Doctor.PatientsModel
@{
    ViewData["Title"] = "Bệnh nhân";
    ViewData["UseSidebar"] = true;
    ViewData["SidebarRole"] = "doctor";
    ViewData["ActiveSidebar"] = "patients";
}

<div class="py-4 px-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold" style="font-size:1.5rem;">Bệnh nhân của tôi</h1>
            <p style="color:var(--mc-text-muted);">Tổng cộng <strong>@Model.Patients.Count</strong> bệnh nhân</p>
        </div>
    </div>

    <!-- Search -->
    <form method="get" class="mb-4">
        <div class="position-relative" style="max-width:400px;">
            <i class="bi bi-search position-absolute" style="left:14px;top:50%;transform:translateY(-50%);color:var(--mc-text-muted);"></i>
            <input asp-for="SearchTerm" class="form-control mc-form-control" placeholder="Tìm kiếm bệnh nhân..." style="padding-left:2.5rem;height:44px;" />
        </div>
    </form>

    <!-- Patient Table -->
    <div class="bg-white rounded-4 border overflow-hidden" style="border-color:var(--mc-border);">
        @if (!Model.Patients.Any())
        {
            <div class="text-center p-5">
                <i class="bi bi-people" style="font-size:2.5rem;color:var(--mc-border);"></i>
                <p class="mt-2" style="color:var(--mc-text-muted);">Chưa có bệnh nhân nào.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr style="background:var(--mc-bg);">
                            <th class="border-0 fw-bold small py-3 ps-4" style="color:var(--mc-text-muted);">Bệnh nhân</th>
                            <th class="border-0 fw-bold small py-3" style="color:var(--mc-text-muted);">Số lần khám</th>
                            <th class="border-0 fw-bold small py-3" style="color:var(--mc-text-muted);">Lần khám cuối</th>
                            <th class="border-0 fw-bold small py-3" style="color:var(--mc-text-muted);">Liên hệ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Patients)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;background:var(--mc-primary-light);color:var(--mc-primary);font-size:0.75rem;">
                                            @p.Patient.FullName.Substring(0, Math.Min(2, p.Patient.FullName.Length)).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold small">@p.Patient.FullName</div>
                                            <div style="font-size:0.7rem;color:var(--mc-text-muted);">@(p.Patient.Gender ?? "")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill" style="background:var(--mc-primary-light);color:var(--mc-primary);">@p.VisitCount lần</span>
                                </td>
                                <td class="small" style="color:var(--mc-text-muted);">@(p.LastVisit?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="small" style="color:var(--mc-text-muted);">
                                    @(p.Patient.Email ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
