@page
@model MediConnect.Server.Pages.Doctor.PatientsModel
@{
    ViewData["Title"] = "Danh sách bệnh nhân";
    ViewData["HideLayout"] = true;
}

<div class="min-h-screen bg-[#f8fafc] flex">
    @await Html.PartialAsync("_DoctorSidebar", "patients")
    <main class="flex-1 overflow-y-auto p-8 space-y-6">
        <div class="flex flex-col gap-3">
            <h1 class="text-4xl md:text-5xl font-black">Danh sách bệnh nhân</h1>
            <p class="text-slate-500">Chọn 1 nhóm và lọc để tìm bệnh nhân nhanh hơn.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
            <a asp-page="/Doctor/Patients" asp-route-category="confirmed" class="rounded-2xl p-4 text-center border transition-all @((Model.Category == "confirmed") ? "bg-primary text-white border-primary" : "bg-white text-slate-700 border-slate-200 hover:border-primary hover:text-primary")">
                <p class="font-semibold">Đã chấp nhận</p>
                <p class="text-sm mt-1 @((Model.Category == "confirmed") ? "text-white/80" : "text-slate-500")">@((Model.Groups.FirstOrDefault(g => g.CategoryKey == "confirmed")?.Patients.Count ?? 0)) bệnh nhân</p>
            </a>
            <a asp-page="/Doctor/Patients" asp-route-category="completed" class="rounded-2xl p-4 text-center border transition-all @((Model.Category == "completed") ? "bg-primary text-white border-primary" : "bg-white text-slate-700 border-slate-200 hover:border-primary hover:text-primary")">
                <p class="font-semibold">Đã khám</p>
                <p class="text-sm mt-1 @((Model.Category == "completed") ? "text-white/80" : "text-slate-500")">@((Model.Groups.FirstOrDefault(g => g.CategoryKey == "completed")?.Patients.Count ?? 0)) bệnh nhân</p>
            </a>
            <a asp-page="/Doctor/Patients" asp-route-category="pending" class="rounded-2xl p-4 text-center border transition-all @((Model.Category == "pending") ? "bg-primary text-white border-primary" : "bg-white text-slate-700 border-slate-200 hover:border-primary hover:text-primary")">
                <p class="font-semibold">Yêu cầu khám</p>
                <p class="text-sm mt-1 @((Model.Category == "pending") ? "text-white/80" : "text-slate-500")">@((Model.Groups.FirstOrDefault(g => g.CategoryKey == "pending")?.Patients.Count ?? 0)) bệnh nhân</p>
            </a>
        </div>

        <section class="bg-white border border-slate-200 rounded-3xl p-5">
            <form method="get" asp-page="/Doctor/Patients" class="grid gap-4 lg:grid-cols-4">
                <input type="hidden" asp-for="Category" />

                <div>
                    <label class="text-sm font-semibold text-slate-700">Họ và tên</label>
                    <input asp-for="SearchName" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" placeholder="Tìm theo tên bệnh nhân" />
                </div>
                <div>
                    <label class="text-sm font-semibold text-slate-700">Loại bệnh</label>
                    <input asp-for="Specialty" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" placeholder="Tìm theo chuyên khoa" />
                </div>
                <div>
                    <label class="text-sm font-semibold text-slate-700">Giới tính</label>
                    <select asp-for="Gender" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm">
                        <option value="">Tất cả</option>
                        <option value="MALE">Nam</option>
                        <option value="FEMALE">Nữ</option>
                        <option value="OTHER">Khác</option>
                    </select>
                </div>
                <div class="flex items-end gap-3">
                    <button type="submit" class="w-full rounded-xl bg-primary px-4 py-3 text-white font-semibold">Lọc</button>
                    <a asp-page="/Doctor/Patients" asp-route-category="@Model.Category" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-center text-slate-700">Xóa lọc</a>
                </div>
            </form>
        </section>

        @if (Model.ActiveGroup == null || !Model.ActiveGroup.Patients.Any())
        {
            <div class="bg-white border border-slate-200 rounded-3xl p-8 text-slate-500">Không có bệnh nhân phù hợp với bộ lọc.</div>
        }
        else
        {
            <section class="bg-white border border-slate-200 rounded-3xl p-5">
                <div class="flex items-center justify-between gap-4 mb-4">
                    <div>
                        <h2 class="text-xl font-semibold">@Model.ActiveGroup.Category</h2>
                        <p class="text-sm text-slate-500 mt-1">@Model.ActiveGroup.Patients.Count bệnh nhân</p>
                    </div>
                </div>

                <div class="space-y-4">
                    @foreach (var patient in Model.ActiveGroup.Patients)
                    {
                        <div class="block rounded-2xl border border-slate-200 p-5 hover:border-primary hover:bg-primary/5">
                            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                                <div>
                                    <p class="font-semibold text-slate-900">@patient.PatientName</p>
                                    <p class="text-sm text-slate-500">@patient.PatientEmail</p>
                                </div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">@patient.Gender</span>
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">@patient.SpecialtyName</span>
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">@patient.Status</span>
                                </div>
                            </div>

                            <div class="mt-4 grid gap-3 sm:grid-cols-3 text-sm text-slate-600">
                                <div><span class="font-semibold">Lần khám mới nhất:</span> @patient.AppointmentDate.ToString("dd/MM/yyyy")</div>
                                <div><span class="font-semibold">Giờ:</span> @patient.StartTime.ToString("HH:mm")</div>
                                <div><span class="font-semibold">Triệu chứng:</span> @patient.Reason</div>
                            </div>

                            <div class="mt-4 flex flex-wrap items-center gap-3">
                                <a asp-page="/Doctor/PatientRecord" asp-route-PatientId="@patient.PatientId" class="px-4 py-2 rounded-full border border-slate-200 text-sm text-slate-700 hover:bg-slate-100 no-underline">Xem hồ sơ</a>
                                @if (!string.Equals(patient.Status, "COMPLETED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a asp-page="/Doctor/Consultation" asp-route-appointmentId="@patient.AppointmentId" class="px-4 py-2 rounded-full bg-primary text-white text-sm no-underline">Khám bệnh</a>
                                }
                                else
                                {
                                    <span class="px-4 py-2 rounded-full border border-slate-200 bg-slate-100 text-slate-500 text-sm">Đã hoàn tất</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </main>
</div>
