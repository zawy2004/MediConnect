@page
@model MediConnect.Server.Pages.Doctor.PatientRecordModel
@{
    ViewData["Title"] = "Xem hồ sơ bệnh nhân";
    ViewData["HideLayout"] = true;
}

<div class="min-h-screen bg-[#f8fafc] flex">
    @await Html.PartialAsync("_DoctorSidebar", "patients")
    <main class="flex-1 overflow-y-auto p-8 space-y-6">
    @if (Model.Data != null)
    {
        <div class="bg-white border rounded-2xl p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div>
                <h1 class="text-4xl font-black">@Model.Data.PatientName</h1>
                <p class="text-slate-500 mt-1">@Model.Data.Age tuổi • @Model.Data.Gender</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="px-3 py-1 rounded-full bg-red-50 text-red-600 text-xs font-bold">Nhóm máu @Model.Data.BloodType</span>
                <a asp-page="/Doctor/ConfirmAppointmentRequest" class="text-slate-500 no-underline">Quay lại</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-3 text-sm">@Model.StatusMessage</div>
        }

        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5">
                    <h2 class="font-bold text-lg">Tóm tắt triệu chứng (AI)</h2>
                    <p class="text-slate-700 mt-2">@Model.Data.SymptomSummary</p>
                </div>

                <div class="bg-white border rounded-2xl p-5">
                    <h2 class="font-bold text-lg mb-3">Lịch sử khám bệnh</h2>
                    <div class="space-y-3">
                        @foreach (var record in Model.Data.History)
                        {
                            <div class="border border-slate-200 rounded-xl p-3">
                                <p class="font-semibold">@record.RecordDate.ToString("dd/MM/yyyy") - @record.Diagnosis</p>
                                <p class="text-sm text-slate-500 mt-1">@record.Notes</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-white border rounded-2xl p-5">
                    <h2 class="font-bold text-lg mb-3">Ghi chú khám</h2>
                    <form method="post" asp-page-handler="SaveNote">
                        <input type="hidden" asp-for="PatientId" />
                        <textarea asp-for="ClinicalNote" rows="5" class="w-full rounded-lg border-slate-200"></textarea>
                        <button class="mt-3 px-4 py-2 bg-primary text-white rounded-xl">Lưu ghi chú</button>
                    </form>
                </div>
            </div>

            <div class="space-y-5">
                <div class="bg-white border rounded-2xl p-5">
                    <h2 class="font-bold text-lg">Chỉ số sinh tồn (cuối)</h2>
                    <p class="mt-3 text-sm">Huyết áp: <span class="font-semibold">@Model.Data.LastBloodPressureSystolic/@Model.Data.LastBloodPressureDiastolic</span></p>
                    <p class="text-sm">Nhịp tim: <span class="font-semibold">@Model.Data.LastHeartRate bpm</span></p>
                </div>

                <div class="bg-white border rounded-2xl p-5">
                    <h2 class="font-bold text-lg mb-3">Tài liệu & kết quả</h2>
                    @foreach (var doc in Model.Data.Documents)
                    {
                        <div class="border border-slate-200 rounded-xl px-3 py-2 mb-2">
                            <p class="font-semibold">@doc.Name</p>
                            <p class="text-xs text-slate-500">@doc.Type • @doc.CreatedAt.ToString("dd/MM/yyyy")</p>
                        </div>
                    }
                </div>

                <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5">
                    <h2 class="font-bold text-amber-700">Cảnh báo dị ứng</h2>
                    <p class="text-sm text-amber-700 mt-2">@Model.Data.AllergyAlert</p>
                </div>
            </div>
        </section>
    }
    </main>
</div>
