@page
@model MediConnect.Server.Pages.Doctor.WaitlistModel
@{
    ViewData["Title"] = "Quản lý Danh sách chờ";
    ViewData["HideLayout"] = true;
}

<div class="min-h-screen bg-[#f8fafc] flex">
    @await Html.PartialAsync("_DoctorSidebar", "waitlist")
    <main class="flex-1 overflow-y-auto p-8 space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-black">Quản lý Danh sách chờ</h1>
                <p class="text-slate-500">Điều chỉnh thứ tự ưu tiên và theo dõi bệnh nhân dự phòng.</p>
            </div>
            <form method="post" asp-page-handler="NotifyNext">
                <button class="px-5 py-2.5 bg-primary text-white rounded-xl">Gửi ngay bây giờ</button>
            </form>
        </div>

        <section class="bg-white border rounded-2xl p-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-xl font-black">Lịch khám</h2>
                    <p class="text-slate-500 text-sm">Xem theo Ngày, Tuần hoặc Tháng.</p>
                </div>
                <div class="flex items-center gap-2">
                    <a asp-page="/Doctor/Waitlist" asp-route-calendarMode="day" class="rounded-full px-3 py-1 text-sm font-semibold @(Model.CalendarMode == "day" ? "bg-primary text-white" : "bg-slate-100 text-slate-600")">Ngày</a>
                    <a asp-page="/Doctor/Waitlist" asp-route-calendarMode="week" class="rounded-full px-3 py-1 text-sm font-semibold @(Model.CalendarMode == "week" ? "bg-primary text-white" : "bg-slate-100 text-slate-600")">Tuần</a>
                    <a asp-page="/Doctor/Waitlist" asp-route-calendarMode="month" class="rounded-full px-3 py-1 text-sm font-semibold @(Model.CalendarMode == "month" ? "bg-primary text-white" : "bg-slate-100 text-slate-600")">Tháng</a>
                </div>
            </div>

            @if (Model.CalendarMode == "month")
            {
                <div class="mt-4 flex items-center justify-between gap-3">
                    <div class="text-sm font-semibold text-slate-700">Tháng @Model.CalendarReference.Month, @Model.CalendarReference.Year</div>
                    <div class="flex items-center gap-2">
                        <button type="button" class="size-10 rounded-full border border-slate-200 bg-white text-slate-600"><span class="material-symbols-outlined">chevron_left</span></button>
                        <button type="button" class="size-10 rounded-full border border-slate-200 bg-white text-slate-600"><span class="material-symbols-outlined">chevron_right</span></button>
                    </div>
                </div>
                <div class="mt-4 grid grid-cols-7 gap-2 text-center text-xs text-slate-500 uppercase">
                    <div>Thứ 2</div>
                    <div>Thứ 3</div>
                    <div>Thứ 4</div>
                    <div>Thứ 5</div>
                    <div>Thứ 6</div>
                    <div>Thứ 7</div>
                    <div>CN</div>
                </div>
                <div class="mt-3 grid grid-cols-7 gap-2 text-xs">
                    @{ var firstOfMonth = new DateOnly(Model.CalendarReference.Year, Model.CalendarReference.Month, 1);
                       var offset = firstOfMonth.DayOfWeek == DayOfWeek.Sunday ? 6 : ((int)firstOfMonth.DayOfWeek - 1);
                    }
                    @for (var i = 0; i < offset; i++)
                    {
                        <div class="h-24 rounded-2xl border border-slate-200 bg-slate-50"></div>
                    }
                    @foreach (var date in Model.CalendarMonthDates)
                    {
                        var events = Model.Data.CalendarEvents.Where(e => e.StartDate == date).ToList();
                        var isToday = date == DateOnly.FromDateTime(DateTime.Today);
                        <div class="min-h-[96px] rounded-2xl border p-3 @(isToday ? "border-primary bg-blue-50" : "border-slate-200 bg-white")">
                            <div class="flex items-center justify-between">
                                <span class="font-semibold">@date.Day</span>
                                <span class="text-[10px] text-slate-500">@events.Count</span>
                            </div>
                            <div class="mt-2 space-y-1">
                                @foreach (var item in events.Take(2))
                                {
                                    <div class="rounded-full px-2 py-1 text-[10px] text-white bg-primary/90 truncate">@item.StartTime.ToString("HH:mm") @item.Title</div>
                                }
                                @if (!events.Any())
                                {
                                    <div class="text-[10px] text-slate-400">Không có</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else if (Model.CalendarMode == "week")
            {
                <div class="mt-4 grid grid-cols-7 gap-2">
                    @foreach (var date in Model.CalendarWeekDates)
                    {
                        var events = Model.Data.CalendarEvents.Where(e => e.StartDate == date).ToList();
                        var isToday = date == DateOnly.FromDateTime(DateTime.Today);
                        <div class="rounded-2xl border p-3 @(isToday ? "border-primary bg-blue-50" : "border-slate-200 bg-slate-50")">
                            <div class="text-[10px] uppercase text-slate-500">@date.DayOfWeek.ToString().Substring(0, 3)</div>
                            <div class="mt-2 text-lg font-semibold">@date.Day</div>
                            <div class="mt-3 space-y-2">
                                @if (events.Any())
                                {
                                    @foreach (var item in events.Take(3))
                                    {
                                        <div class="rounded-2xl border px-2 py-2 text-[11px] bg-white">
                                            <div class="font-semibold">@item.StartTime.ToString("HH:mm")</div>
                                            <div class="text-slate-500 truncate">@item.Title</div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="rounded-2xl border border-dashed border-slate-200 bg-white py-3 text-[11px] text-slate-400">Trống</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="mt-4 grid gap-3">
                    @{ var selectedDate = DateOnly.FromDateTime(DateTime.Today);
                       var dayEvents = Model.Data.CalendarEvents.Where(e => e.StartDate == selectedDate).OrderBy(e => e.StartTime).ToList(); }
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs uppercase text-slate-500">Ngày</p>
                            <p class="text-lg font-semibold">@selectedDate.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div class="text-sm text-slate-500">@dayEvents.Count sự kiện</div>
                    </div>
                    @if (dayEvents.Any())
                    {
                        @foreach (var item in dayEvents)
                        {
                            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                <div class="flex items-center justify-between gap-3">
                                    <div>
                                        <div class="font-semibold">@item.Title</div>
                                        <div class="text-sm text-slate-500">@item.PatientName</div>
                                    </div>
                                    <span class="text-xs rounded-full px-2 py-1 @(item.Status == "COMPLETED" ? "bg-slate-100 text-slate-600" : "bg-emerald-100 text-emerald-700")">@item.Status</span>
                                </div>
                                <div class="mt-3 text-sm text-slate-500">@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-6 text-center text-sm text-slate-500">Không có lịch trong ngày.</div>
                    }
                </div>
            }
        </section>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="bg-blue-50 border border-blue-200 text-blue-700 rounded-xl px-4 py-3 text-sm">@Model.StatusMessage</div>
    }

        <div class="bg-white border rounded-2xl p-2 inline-flex gap-1">
            <button type="button" class="px-4 py-2 rounded-xl bg-primary text-white text-sm font-semibold">Tất cả</button>
            <button type="button" class="px-4 py-2 rounded-xl text-sm text-slate-600">Cấp cứu</button>
            <button type="button" class="px-4 py-2 rounded-xl text-sm text-slate-600">Đang thông báo</button>
        </div>

        <section class="grid grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="bg-white border rounded-2xl p-4"><p class="text-xs text-slate-500">Trạng thái</p><p class="text-2xl font-black mt-2">@(Model.Data.IsFullToday ? "Lịch đã đầy" : "Còn slot")</p></div>
            <div class="bg-white border rounded-2xl p-4"><p class="text-xs text-slate-500">Tổng trong hàng chờ</p><p class="text-2xl font-black mt-2">@Model.Data.TotalCount</p></div>
            <div class="bg-white border rounded-2xl p-4"><p class="text-xs text-slate-500">Hiệu suất chờ</p><p class="text-2xl font-black mt-2">@Model.Data.AverageWaitMinutes phút</p></div>
        </section>

    <section class="bg-white border rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 text-slate-500">
                <tr>
                    <th class="text-left px-4 py-3 w-20">Thứ tự</th>
                    <th class="text-left px-4 py-3">Bệnh nhân</th>
                    <th class="text-left px-4 py-3">Thời gian đăng ký</th>
                    <th class="text-left px-4 py-3">Trạng thái</th>
                    <th class="text-left px-4 py-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data.Items)
                {
                    <tr class="border-t border-slate-100 hover:bg-slate-50">
                        <td class="px-4 py-3 font-semibold">@item.Order.ToString("00")</td>
                        <td class="px-4 py-3">@item.PatientName</td>
                        <td class="px-4 py-3">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-4 py-3"><span class="px-2 py-1 rounded-full text-xs bg-slate-100 text-slate-700">@item.Status</span></td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <form method="post" asp-page-handler="MoveUp">
                                    <input type="hidden" name="waitlistId" value="@item.WaitlistId" />
                                    <button class="px-2 py-1 border rounded-lg">↑</button>
                                </form>
                                <form method="post" asp-page-handler="MoveDown">
                                    <input type="hidden" name="waitlistId" value="@item.WaitlistId" />
                                    <button class="px-2 py-1 border rounded-lg">↓</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="bg-white border rounded-2xl p-5">
                <h3 class="text-2xl font-black">Hiệu suất chờ</h3>
                <p class="text-5xl font-black mt-4">@Model.Data.AverageWaitMinutes <span class="text-base font-semibold text-slate-500">phút</span></p>
                <p class="text-sm text-slate-500 mt-2">Thời gian chờ trung bình hiện tại.</p>
            </div>
            <div class="lg:col-span-2 bg-gradient-to-br from-blue-700 to-blue-800 text-white rounded-2xl p-6">
                <h3 class="text-4xl font-black">Gửi thông báo hàng loạt cho các slot trống sắp tới?</h3>
                <p class="mt-2 text-sm text-blue-100">Hệ thống phát hiện slot trống và có thể gửi thông báo tự động.</p>
                <form method="post" asp-page-handler="NotifyNext" class="mt-4">
                    <button class="px-5 py-2.5 bg-white text-blue-700 rounded-xl font-semibold">Gửi ngay bây giờ</button>
                </form>
            </div>
        </section>
    </main>
</div>
