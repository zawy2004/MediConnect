@page
@model MediConnect.Server.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
    var isPatient = User.Identity?.IsAuthenticated == true && User.IsInRole("PATIENT");
    var visitorName = User.Identity?.Name;
}

@if (isPatient)
{
    <div class="bg-white border-b border-slate-200">
        <div class="max-w-[1280px] mx-auto px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-primary">Chế độ bệnh nhân</p>
                <p class="text-[#0d141b] font-bold text-lg mt-0.5">Xin chào, <span class="text-primary">@(visitorName ?? "bạn")</span></p>
                <p class="text-slate-500 text-sm mt-1">Tiếp tục đặt lịch hoặc xem tổng quan cá nhân.</p>
            </div>
            <div class="flex flex-wrap gap-2 shrink-0">
                <a asp-page="/Patient/Dashboard" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-primary text-white text-sm font-bold rounded-xl hover:bg-primary/90 transition-all no-underline shadow-sm">
                    <span class="material-symbols-outlined text-lg">dashboard</span>
                    Vào trang chủ của tôi
                </a>
                <a asp-page="/Patient/SearchDoctors" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-slate-100 text-slate-800 text-sm font-bold rounded-xl hover:bg-slate-200 transition-all no-underline">
                    <span class="material-symbols-outlined text-lg">search</span>
                    Đặt lịch nhanh
                </a>
            </div>
        </div>
    </div>
}

<!-- Hero Section -->
<div class="bg-gradient-to-br from-primary via-[#137fec] to-blue-700 text-white">
    <div class="max-w-[1280px] mx-auto px-6 py-14 lg:py-20">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
            <div class="flex-1 text-center lg:text-left">
                <p class="text-white/80 text-sm font-bold uppercase tracking-widest mb-3">MediConnect</p>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight mb-5">
                    Đặt lịch khám — đơn giản, minh bạch
                </h1>
                <p class="text-lg text-white/85 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                    Kết nối với bác sĩ và chuyên khoa phù hợp, theo dõi lịch hẹn và nhận gợi ý sức khỏe ngay trên một nền tảng.
                </p>
                <div class="flex flex-row flex-wrap justify-center lg:justify-start gap-3">
                    <a asp-page="/Doctors/Index" class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 bg-white text-primary font-bold rounded-xl hover:bg-slate-50 transition-all no-underline shadow-lg min-w-0">
                        <span class="material-symbols-outlined shrink-0 text-xl">search</span>
                        <span class="whitespace-nowrap">Tìm bác sĩ</span>
                    </a>
                    <a asp-page="/Appointments/Create" class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 bg-white/15 text-white font-bold rounded-xl hover:bg-white/25 transition-all no-underline border border-white/35 min-w-0">
                        <span class="material-symbols-outlined shrink-0 text-xl">calendar_month</span>
                        <span class="whitespace-nowrap">Đặt lịch hẹn</span>
                    </a>
                    @if (!isPatient)
                    {
                        <a asp-page="/Auth/Register" class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 font-bold rounded-xl text-white/95 hover:bg-white/10 transition-all no-underline border border-white/25 min-w-0">
                            <span class="whitespace-nowrap">Tạo tài khoản</span>
                        </a>
                    }
                </div>
            </div>
            <div class="flex-shrink-0 w-full max-w-[420px] lg:max-w-[440px] mx-auto lg:mx-0" role="img" aria-label="Minh họa đặt lịch khám trực tuyến">
                <div class="relative rounded-3xl bg-white/10 backdrop-blur-md border border-white/25 shadow-2xl p-6 sm:p-8 overflow-hidden">
                    <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-white/10 pointer-events-none"></div>
                    <div class="absolute -bottom-16 -left-8 w-48 h-48 rounded-full bg-blue-900/20 pointer-events-none"></div>
                    <svg class="relative z-[1] w-full h-auto text-white" viewBox="0 0 360 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect x="24" y="32" width="180" height="118" rx="16" fill="white" fill-opacity="0.92"/>
                        <rect x="44" y="52" width="72" height="10" rx="4" fill="#137fec" fill-opacity="0.35"/>
                        <rect x="44" y="70" width="120" height="8" rx="3" fill="#64748b" fill-opacity="0.25"/>
                        <rect x="44" y="86" width="100" height="8" rx="3" fill="#64748b" fill-opacity="0.2"/>
                        <circle cx="64" cy="118" r="18" fill="#137fec" fill-opacity="0.2"/>
                        <path d="M64 110v10M60 114h8" stroke="#137fec" stroke-width="2" stroke-linecap="round"/>
                        <rect x="92" y="108" width="88" height="6" rx="2" fill="#64748b" fill-opacity="0.3"/>
                        <rect x="92" y="120" width="64" height="6" rx="2" fill="#64748b" fill-opacity="0.18"/>
                        <rect x="214" y="48" width="122" height="152" rx="18" fill="white" fill-opacity="0.22" stroke="white" stroke-opacity="0.35" stroke-width="1"/>
                        <rect x="230" y="68" width="90" height="12" rx="4" fill="white" fill-opacity="0.45"/>
                        <rect x="230" y="92" width="74" height="8" rx="3" fill="white" fill-opacity="0.28"/>
                        <rect x="230" y="108" width="82" height="8" rx="3" fill="white" fill-opacity="0.22"/>
                        <rect x="230" y="132" width="90" height="44" rx="10" fill="#137fec" fill-opacity="0.35"/>
                        <path d="M258 153l10 10 20-22" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="180" cy="218" r="36" fill="white" fill-opacity="0.18" stroke="white" stroke-opacity="0.4" stroke-width="1.5"/>
                        <path d="M180 198c-8 10-22 28-22 40a22 22 0 0044 0c0-12-14-30-22-40z" fill="white" fill-opacity="0.9"/>
                        <path d="M152 232h56" stroke="white" stroke-opacity="0.55" stroke-width="2" stroke-linecap="round"/>
                        <path d="M164 220h32" stroke="white" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!isPatient)
{
    <div class="max-w-[1280px] mx-auto px-6 -mt-6 relative z-10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <a asp-page="/Doctors/Index" class="bg-white rounded-xl border border-slate-200/80 p-4 shadow-md flex items-center gap-4 no-underline card-hover-effect group">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/15 transition-colors">
                    <span class="material-symbols-outlined text-primary">person_search</span>
                </div>
                <div class="min-w-0 text-left">
                    <p class="font-bold text-[#0d141b]">Tìm bác sĩ</p>
                    <p class="text-xs text-slate-500 mt-0.5">Lọc theo chuyên khoa &amp; lịch trống</p>
                </div>
            </a>
            <a asp-page="/Specialties/Index" class="bg-white rounded-xl border border-slate-200/80 p-4 shadow-md flex items-center gap-4 no-underline card-hover-effect group">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-emerald-600">medical_services</span>
                </div>
                <div class="min-w-0 text-left">
                    <p class="font-bold text-[#0d141b]">Chuyên khoa</p>
                    <p class="text-xs text-slate-500 mt-0.5">Khám phá danh mục điều trị</p>
                </div>
            </a>
            <a asp-page="/Appointments/Index" class="bg-white rounded-xl border border-slate-200/80 p-4 shadow-md flex items-center gap-4 no-underline card-hover-effect group">
                <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-amber-600">event_available</span>
                </div>
                <div class="min-w-0 text-left">
                    <p class="font-bold text-[#0d141b]">Lịch hẹn</p>
                    <p class="text-xs text-slate-500 mt-0.5">Xem hoặc quản lý cuộc hẹn</p>
                </div>
            </a>
        </div>
    </div>
}

<!-- Statistics -->
<div class="max-w-[1280px] mx-auto px-6 @(isPatient ? "pt-10" : "pt-12")">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white rounded-xl border border-[#cfdbe7] p-5 sm:p-6 shadow-sm text-center card-hover-effect">
            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-primary">groups</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-[#0d141b]">@Model.TotalPatients</h3>
            <p class="text-[#4c739a] text-xs sm:text-sm">Bệnh nhân</p>
        </div>
        <div class="bg-white rounded-xl border border-[#cfdbe7] p-5 sm:p-6 shadow-sm text-center card-hover-effect">
            <div class="w-11 h-11 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-green-600">person_check</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-[#0d141b]">@Model.TotalDoctors</h3>
            <p class="text-[#4c739a] text-xs sm:text-sm">Bác sĩ</p>
        </div>
        <div class="bg-white rounded-xl border border-[#cfdbe7] p-5 sm:p-6 shadow-sm text-center card-hover-effect">
            <div class="w-11 h-11 rounded-full bg-blue-100 flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-blue-600">calendar_month</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-[#0d141b]">@Model.TotalAppointments</h3>
            <p class="text-[#4c739a] text-xs sm:text-sm">Lịch hẹn</p>
        </div>
        <div class="bg-white rounded-xl border border-[#cfdbe7] p-5 sm:p-6 shadow-sm text-center card-hover-effect">
            <div class="w-11 h-11 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-red-500">cardiology</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-[#0d141b]">@Model.TotalSpecialties</h3>
            <p class="text-[#4c739a] text-xs sm:text-sm">Chuyên khoa</p>
        </div>
    </div>
</div>

<!-- Specialties Section -->
<div class="max-w-[1280px] mx-auto px-6 py-12 lg:py-16">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
            <h2 class="text-[#0d141b] text-2xl font-extrabold tracking-tight">Chuyên khoa nổi bật</h2>
            <p class="text-[#4c739a] mt-1 text-sm sm:text-base max-w-2xl">Chọn chuyên khoa để xem bác sĩ phù hợp — thông tin được sắp xếp gọn để bạn quyết định nhanh hơn.</p>
        </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        @foreach (var spec in Model.Specialties)
        {
            <div class="bg-white rounded-xl border border-[#cfdbe7] p-5 shadow-sm flex flex-col card-hover-effect min-h-[200px]">
                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-primary">medical_services</span>
                </div>
                <h3 class="text-[#0d141b] text-sm font-bold mb-1 line-clamp-2">@spec.SpecialtyName</h3>
                <p class="text-[#4c739a] text-xs mb-4 line-clamp-3 grow">@spec.Description</p>
                <a asp-page="/Doctors/Index" asp-route-specialtyId="@spec.SpecialtyId"
                   class="text-primary text-xs font-bold hover:underline no-underline mt-auto inline-flex items-center gap-1">
                    Xem bác sĩ
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>
        }
    </div>
</div>
