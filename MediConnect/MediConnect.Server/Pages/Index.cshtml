@page
@model MediConnect.Server.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Section -->
<div class="bg-gradient-to-r from-primary to-blue-600 text-white">
    <div class="max-w-[1280px] mx-auto px-6 py-16">
        <div class="flex flex-col lg:flex-row items-center gap-12">
            <div class="flex-1">
                <h1 class="text-4xl lg:text-5xl font-black leading-tight tracking-tight mb-6">
                    Chào mừng đến MediConnect
                </h1>
                <p class="text-xl text-white/80 mb-8 max-w-lg leading-relaxed">
                    Nền tảng đặt lịch khám bệnh trực tuyến — kết nối bệnh nhân với bác sĩ một cách nhanh chóng và tiện lợi.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a asp-page="/Doctors/Index" class="flex items-center gap-2 px-8 py-4 bg-white text-primary font-bold rounded-xl hover:bg-slate-50 transition-all no-underline shadow-lg">
                        <span class="material-symbols-outlined">search</span> Tìm bác sĩ
                    </a>
                    <a asp-page="/Appointments/Create" class="flex items-center gap-2 px-8 py-4 bg-white/20 text-white font-bold rounded-xl hover:bg-white/30 transition-all no-underline border border-white/30">
                        <span class="material-symbols-outlined">calendar_month</span> Đặt lịch hẹn
                    </a>
                </div>
            </div>
            <div class="flex-shrink-0 hidden lg:block">
                <div class="w-80 h-80 rounded-3xl bg-white/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-white/30" style="font-size: 10rem;">cardiology</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistics -->
<div class="max-w-[1280px] mx-auto px-6 -mt-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-[#cfdbe7] p-6 shadow-sm text-center card-hover-effect">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-primary">groups</span>
            </div>
            <h3 class="text-2xl font-black text-[#0d141b]">@Model.TotalPatients</h3>
            <p class="text-[#4c739a] text-sm">Bệnh nhân</p>
        </div>
        <div class="bg-white rounded-xl border border-[#cfdbe7] p-6 shadow-sm text-center card-hover-effect">
            <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-green-600">person_check</span>
            </div>
            <h3 class="text-2xl font-black text-[#0d141b]">@Model.TotalDoctors</h3>
            <p class="text-[#4c739a] text-sm">Bác sĩ</p>
        </div>
        <div class="bg-white rounded-xl border border-[#cfdbe7] p-6 shadow-sm text-center card-hover-effect">
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-blue-600">calendar_month</span>
            </div>
            <h3 class="text-2xl font-black text-[#0d141b]">@Model.TotalAppointments</h3>
            <p class="text-[#4c739a] text-sm">Lịch hẹn</p>
        </div>
        <div class="bg-white rounded-xl border border-[#cfdbe7] p-6 shadow-sm text-center card-hover-effect">
            <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-red-500">cardiology</span>
            </div>
            <h3 class="text-2xl font-black text-[#0d141b]">@Model.TotalSpecialties</h3>
            <p class="text-[#4c739a] text-sm">Chuyên khoa</p>
        </div>
    </div>
</div>

<!-- Specialties Section -->
<div class="max-w-[1280px] mx-auto px-6 py-12">
    <div class="mb-8">
        <h2 class="text-[#0d141b] text-2xl font-extrabold tracking-tight">Chuyên khoa nổi bật</h2>
        <p class="text-[#4c739a] mt-1">Tìm bác sĩ theo chuyên khoa phù hợp với nhu cầu của bạn</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        @foreach (var spec in Model.Specialties)
        {
            <div class="bg-white rounded-xl border border-[#cfdbe7] p-5 shadow-sm text-center card-hover-effect">
                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined text-primary">medical_services</span>
                </div>
                <h3 class="text-[#0d141b] text-sm font-bold mb-1">@spec.SpecialtyName</h3>
                <p class="text-[#4c739a] text-xs mb-3">@spec.Description</p>
                <a asp-page="/Doctors/Index" asp-route-specialtyId="@spec.SpecialtyId"
                   class="text-primary text-xs font-bold hover:underline no-underline">
                    Xem bác sĩ →
                </a>
            </div>
        }
    </div>
</div>
